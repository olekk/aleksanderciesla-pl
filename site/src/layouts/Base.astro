---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'Strony internetowe, Google Ads i widoczność w AI dla małych firm. Zrobię to za Ciebie i co miesiąc pokażę, ile zapytań to dało. Jawne ceny.',
  jsonLd: extraLd = [],
} = Astro.props;

const fullTitle = title
  ? `${title} | ${site.brandName}`
  : `${site.brandName} – strony, Google Ads i widoczność w AI dla małych firm`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.personName,
      url: site.url,
      jobTitle: 'Strony internetowe i marketing dla małych firm',
      ...(site.email ? { email: `mailto:${site.email}` } : {}),
      ...(site.phone ? { telephone: site.phone } : {}),
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#service`,
      name: site.brandName,
      url: site.url,
      founder: { '@id': `${site.url}/#person` },
      areaServed: 'Polska',
    },
    ...extraLd,
  ],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#06070b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/media/gibmeble-desktop.webp', site.url).href} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <div class="aurora-layer"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </div>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Nagrania startują dopiero, gdy są widoczne, i zatrzymują się poza ekranem.
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');
      if (reduce) {
        videos.forEach((v) => (v.controls = true));
      } else {
        const vio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const v = e.target as HTMLVideoElement;
              if (e.isIntersecting) {
                if (v.preload === 'none') v.preload = 'auto';
                v.play().catch(() => {});
              } else v.pause();
            }
          },
          { threshold: 0.3 },
        );
        videos.forEach((v) => vio.observe(v));
      }

      // Sekcje wjeżdżają przy przewijaniu.
      const rio = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            if (e.isIntersecting) {
              e.target.classList.add('in');
              rio.unobserve(e.target);
            }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => rio.observe(el));

      // "Elastyczne" przewijanie: przy szybkim przewijaniu odstępy między sekcjami lekko się rozciągają,
      // po zatrzymaniu wracają ze sprężynowaniem; przewinięcie za górę / dół strony rozciąga całość.
      // Przesunięcia rosną monotonicznie od góry do dołu, więc sekcje nigdy na siebie nie nachodzą.
      // Tylko transformy (bez zmian układu), wyłączone przy prefers-reduced-motion.
      const layer = document.querySelector<HTMLElement>('.aurora-layer');
      const PARALLAX = 0.12; // tło jedzie w tę samą stronę co treść, ale ok. 8 razy wolniej
      const items = Array.from(document.querySelectorAll<HTMLElement>('main > *, body > footer'));
      if (!reduce && items.length) {
        const K = 1.4; // siła rozciągania od prędkości
        const MAX = 90; // maks. przesunięcie sekcji w px
        const n = items.length;
        let centers: number[] = [];
        const x = new Float64Array(n);
        const vel = new Float64Array(n);
        let lastY = scrollY;
        let speed = 0;
        let pull = 0; // > 0 za górą strony, < 0 za dołem
        let running = false;

        const measure = () => {
          centers = items.map((el) => el.offsetTop + el.offsetHeight / 2);
          if (layer) layer.style.height = `${innerHeight + Math.max(0, document.documentElement.scrollHeight - innerHeight) * PARALLAX + 40}px`;
        };
        measure();
        addEventListener('resize', measure, { passive: true });
        new ResizeObserver(measure).observe(document.body);

        const tick = () => {
          const y = scrollY;
          // Skok (np. wyszukiwanie na stronie) nie może wystrzelić sekcji: prędkość przycięta.
          speed = speed * 0.75 + Math.max(-60, Math.min(60, y - lastY)) * 0.25;
          lastY = y;
          pull *= 0.86;
          if (Math.abs(pull) < 0.2) pull = 0;
          const vh = innerHeight;
          const mid = y + vh / 2;
          let moving = Math.abs(speed) > 0.05 || pull !== 0;
          for (let i = 0; i < n; i++) {
            const d = Math.max(-2, Math.min(2, (centers[i] - mid) / vh));
            let target = Math.max(-MAX, Math.min(MAX, speed * K * d));
            if (pull > 0) target += pull * (0.35 + 0.18 * i);
            else if (pull < 0) target += pull * (0.35 + 0.18 * (n - 1 - i));
            vel[i] = (vel[i] + (target - x[i]) * 0.085) * 0.8;
            x[i] += vel[i];
            if (Math.abs(x[i]) > 0.1 || Math.abs(vel[i]) > 0.05) moving = true;
            items[i].style.transform = Math.abs(x[i]) < 0.1 ? '' : `translate3d(0,${x[i].toFixed(2)}px,0)`;
          }
          if (moving) requestAnimationFrame(tick);
          else running = false;
        };
        const kick = () => {
          if (!running) {
            running = true;
            requestAnimationFrame(tick);
          }
        };
        addEventListener('scroll', kick, { passive: true });
        // Kółko myszy / gładzik za krawędzią strony: przeglądarka nie przewija, więc rozciągamy sami.
        addEventListener(
          'wheel',
          (e) => {
            const max = document.documentElement.scrollHeight - innerHeight;
            if (e.deltaY < 0 && scrollY <= 0) pull = Math.min(160, pull - e.deltaY * 0.25);
            else if (e.deltaY > 0 && scrollY >= max - 1) pull = Math.max(-160, pull - e.deltaY * 0.25);
            else return;
            kick();
          },
          { passive: true },
        );
      }

      // Tło (poświaty) przesuwa się razem z treścią, ale dużo wolniej.
      if (layer && !reduce) {
        let queued = false;
        const move = () => {
          layer.style.transform = `translate3d(0,${(-scrollY * PARALLAX).toFixed(1)}px,0)`;
          queued = false;
        };
        move();
        addEventListener(
          'scroll',
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(move);
            }
          },
          { passive: true },
        );
      }

      // Odblask na szkle podąża za kursorem (tylko mysz, nie dotyk).
      if (!reduce && matchMedia('(pointer: fine)').matches) {
        document.addEventListener(
          'pointermove',
          (ev) => {
            const el = (ev.target as Element).closest<HTMLElement>('.glass');
            if (!el) return;
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${ev.clientX - r.left}px`);
            el.style.setProperty('--my', `${ev.clientY - r.top}px`);
          },
          { passive: true },
        );
      }
    </script>
    {
      site.cfAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}
        />
      )
    }
  </body>
</html>
