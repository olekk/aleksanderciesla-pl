---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = 'Strony internetowe, Google Ads i widoczność w AI dla małych i średnich przedsiębiorstw. Zrobię to za Ciebie i co miesiąc pokażę, ile zapytań to dało. Jawne ceny.',
  jsonLd: extraLd = [],
} = Astro.props;

const fullTitle = title
  ? `${title} | ${site.brandName}`
  : `${site.brandName} – strony, Google Ads i widoczność w AI dla MŚP`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.personName,
      url: site.url,
      jobTitle: 'Strony internetowe i marketing dla małych i średnich przedsiębiorstw',
      ...(site.email ? { email: `mailto:${site.email}` } : {}),
      ...(site.phone ? { telephone: site.phone } : {}),
      ...(site.photo ? { image: new URL(site.photo, site.url).href } : {}),
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#service`,
      name: site.brandName,
      url: site.url,
      founder: { '@id': `${site.url}/#person` },
      areaServed: 'Polska',
    },
    ...extraLd,
  ],
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#06070b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Font od razu, żeby nagłówek (LCP) nie czekał na podmianę fontu. -->
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-pl.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/media/gibmeble-desktop.webp', site.url).href} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <div class="aurora-layer"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </div>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <script>
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      addEventListener('load', () => setTimeout(() => document.documentElement.classList.add('smooth'), 500));

      // Nagrania startują dopiero, gdy są widoczne, i zatrzymują się poza ekranem.
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]');

      // Plakaty nagrań ładujemy dopiero blisko ekranu i w rozmiarze pod ekran (mały plik na telefonie).
      const setPoster = (v: HTMLVideoElement) => {
        const base = v.dataset.poster;
        if (!base || v.poster) return;
        const need = v.clientWidth * (devicePixelRatio || 1);
        const small = base.endsWith('-mobile') ? 260 : 640;
        v.poster = need <= small * 1.1 ? `${base}-${small}.webp` : `${base}.webp`;
      };
      // W karuzeli slajdy są przycięte przez kontener, więc obserwujemy całą karuzelę i ładujemy jej plakaty razem.
      const posterGroups = new Map<Element, HTMLVideoElement[]>();
      videos.forEach((v) => {
        const key = v.closest('.carousel') || v;
        posterGroups.set(key, [...(posterGroups.get(key) || []), v]);
      });
      const pio = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            if (e.isIntersecting) {
              posterGroups.get(e.target)?.forEach(setPoster);
              pio.unobserve(e.target);
            }
        },
        { rootMargin: '600px 0px' },
      );
      posterGroups.forEach((_, el) => pio.observe(el));
      if (reduce) {
        videos.forEach((v) => (v.controls = true));
      } else {
        const vio = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const v = e.target as HTMLVideoElement;
              if (e.isIntersecting) {
                if (v.preload === 'none') v.preload = 'auto';
                v.play().catch(() => {});
              } else v.pause();
            }
          },
          { threshold: 0.3 },
        );
        videos.forEach((v) => vio.observe(v));
      }

      // Sekcje wjeżdżają przy przewijaniu.
      const rio = new IntersectionObserver(
        (entries) => {
          for (const e of entries)
            if (e.isIntersecting) {
              e.target.classList.add('in');
              rio.unobserve(e.target);
            }
        },
        { rootMargin: '0px 0px -8% 0px' },
      );
      // Wejście z #kotwicą: przeglądarka przewija dopiero po skrypcie, a układ zmienia się jeszcze po załadowaniu
      // fontów, więc nie wiadomo, co będzie na pierwszym ekranie. Wtedy nic nie ukrywamy (LCP, Lighthouse).
      if (!reduce && !location.hash)
        document.querySelectorAll('.reveal').forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.top < innerHeight && r.bottom > 0) return; // widoczne od początku: bez animacji
          el.classList.add('pre');
          rio.observe(el);
        });

      // "Bezwładne" przewijanie (na prośbę Olka 26.11.2026): przy przewijaniu sekcje lekko nie nadążają za stroną,
      // a po zahamowaniu dojeżdżają na miejsce jednym płynnym ruchem (sprężyna prawie krytycznie tłumiona, bez
      // drgań). Sekcje dalej w kierunku ruchu zostają odrobinę bardziej, więc odstępy tylko się rozciągają:
      // przesunięcia rosną monotonicznie od góry do dołu i sekcje nigdy na siebie nie nachodzą.
      // Przewinięcie kółkiem za górę / dół strony rozciąga całość.
      // Tylko transformy (bez zmian układu), wyłączone przy prefers-reduced-motion.
      const layer = document.querySelector<HTMLElement>('.aurora-layer');
      // Tło jedzie w tę samą stronę co treść, ale dużo wolniej: tak, żeby warstwa (300vh) starczyła do końca strony,
      // najwyżej 0,15 prędkości treści.
      let PARALLAX = 0.12;
      const fitParallax = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        PARALLAX = max > 0 ? Math.min(0.15, (2 * innerHeight) / max) : 0;
      };
      fitParallax();
      const items = Array.from(document.querySelectorAll<HTMLElement>('main > *, body > footer'));
      if (!reduce && items.length) {
        const K = 1.1; // jak bardzo sekcje zostają w tyle przy danej prędkości
        const SPREAD = 0.25; // o ile bardziej zostają sekcje dalej w kierunku ruchu
        const MAX = 70; // maks. przesunięcie sekcji w px
        const STIFF = 0.07; // sztywność sprężyny
        const DAMP = 0.6; // tłumienie: przy 0.07 / 0.6 brak przestrzelenia, dojazd ok. 0,5 s
        const n = items.length;
        let centers: number[] = [];
        const x = new Float64Array(n);
        const vel = new Float64Array(n);
        let lastY = scrollY;
        let speed = 0;
        let pull = 0; // > 0 za górą strony, < 0 za dołem
        let running = false;

        const measure = () => {
          centers = items.map((el) => el.offsetTop + el.offsetHeight / 2);
          fitParallax();
        };
        measure();
        addEventListener('resize', measure, { passive: true });
        new ResizeObserver(measure).observe(document.body);

        const tick = () => {
          const y = scrollY;
          // Skok (np. wyszukiwanie na stronie) nie może wystrzelić sekcji: prędkość przycięta.
          speed = speed * 0.75 + Math.max(-60, Math.min(60, y - lastY)) * 0.25;
          lastY = y;
          pull *= 0.86;
          if (Math.abs(pull) < 0.2) pull = 0;
          if (Math.abs(speed) < 0.05) speed = 0;
          const vh = innerHeight;
          const mid = y + vh / 2;
          let moving = Math.abs(speed) > 0.05 || pull !== 0;
          for (let i = 0; i < n; i++) {
            const d = Math.max(-2, Math.min(2, (centers[i] - mid) / vh));
            let target = Math.max(-MAX, Math.min(MAX, speed * K + Math.abs(speed) * K * SPREAD * d));
            if (pull > 0) target += pull * (0.35 + 0.18 * i);
            else if (pull < 0) target += pull * (0.35 + 0.18 * (n - 1 - i));
            vel[i] = (vel[i] + (target - x[i]) * STIFF) * DAMP;
            x[i] += vel[i];
            if (Math.abs(x[i]) > 0.1 || Math.abs(vel[i]) > 0.05) moving = true;
            items[i].style.transform = Math.abs(x[i]) < 0.1 ? '' : `translate3d(0,${x[i].toFixed(2)}px,0)`;
          }
          if (moving) requestAnimationFrame(tick);
          else running = false;
        };
        const kick = () => {
          if (!running) {
            running = true;
            requestAnimationFrame(tick);
          }
        };
        addEventListener('scroll', kick, { passive: true });
        // Kółko myszy / gładzik za krawędzią strony: przeglądarka nie przewija, więc rozciągamy sami.
        addEventListener(
          'wheel',
          (e) => {
            const max = document.documentElement.scrollHeight - innerHeight;
            if (e.deltaY < 0 && scrollY <= 0) pull = Math.min(160, pull - e.deltaY * 0.25);
            else if (e.deltaY > 0 && scrollY >= max - 1) pull = Math.max(-160, pull - e.deltaY * 0.25);
            else return;
            kick();
          },
          { passive: true },
        );
      }

      // Tło (poświaty) przesuwa się razem z treścią, ale dużo wolniej.
      if (layer && !reduce) {
        let queued = false;
        const move = () => {
          layer.style.transform = `translate3d(0,${(-scrollY * PARALLAX).toFixed(1)}px,0)`;
          queued = false;
        };
        move();
        addEventListener(
          'scroll',
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(move);
            }
          },
          { passive: true },
        );
      }

      // Odblask na szkle podąża za kursorem (tylko mysz, nie dotyk).
      if (!reduce && matchMedia('(pointer: fine)').matches) {
        document.addEventListener(
          'pointermove',
          (ev) => {
            const el = (ev.target as Element).closest<HTMLElement>('.glass');
            if (!el) return;
            const r = el.getBoundingClientRect();
            el.style.setProperty('--mx', `${ev.clientX - r.left}px`);
            el.style.setProperty('--my', `${ev.clientY - r.top}px`);
          },
          { passive: true },
        );
      }
    </script>
    {
      site.cfAnalyticsToken && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.cfAnalyticsToken })}
        />
      )
    }
  </body>
</html>
