<script>
  // Karuzela w pętli: za ostatnim slajdem wraca na początek (i odwrotnie); sama przewija się co 5 s,
  // gdy jest widoczna i nikt jej nie dotyka (na prośbę Olka 26.11.2026).
  const car = document.querySelector<HTMLElement>('#karuzela');
  if (car) {
    const step = (dir: number) => {
      const slide = car.querySelector<HTMLElement>('.slide');
      const w = (slide?.offsetWidth || 400) + 20;
      const max = car.scrollWidth - car.clientWidth;
      let left = car.scrollLeft + dir * w;
      if (dir > 0 && car.scrollLeft >= max - 4) left = 0;
      else if (dir < 0 && car.scrollLeft <= 4) left = max;
      car.scrollTo({ left, behavior: 'smooth' });
    };
    document.querySelectorAll<HTMLButtonElement>('.nav-btn').forEach((b) =>
      b.addEventListener('click', () => {
        step(Number(b.dataset.dir));
        pausedUntil = Date.now() + 10000;
      }),
    );
    let pausedUntil = 0;
    let hover = false;
    let visible = false;
    car.addEventListener('pointerenter', () => (hover = true));
    car.addEventListener('pointerleave', () => (hover = false));
    car.addEventListener('touchstart', () => (pausedUntil = Date.now() + 10000), { passive: true });
    car.addEventListener('focusin', () => (pausedUntil = Date.now() + 10000));
    new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.5 }).observe(car);
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
      setInterval(() => {
        if (visible && !hover && Date.now() > pausedUntil && !document.hidden) step(1);
      }, 5000);
  }
</script>

