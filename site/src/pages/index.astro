---
import Base from '../layouts/Base.astro';
import Showcase from '../components/Showcase.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import { site, priceSuffix } from '../config/site';
import { featured, agencySites, quotes } from '../data/projects';

const artPapier = featured[0];
const hc = featured[1];
const p = site.prices;

const names = ['Art Papier', 'HC INSTAL', 'GiB Meble', 'Foto7', 'Prodvisor', 'Auto-Centrum Gliwice', 'Vibeon', 'Liberta Okna'];

const pains = [
  'Płacisz za reklamy, ale nie wiesz, ile zapytań z nich masz.',
  'Strona ma kilka lat, wolno działa na telefonie i nikt z niej nie dzwoni.',
  'Zapytania przychodzą mailem, telefonem i z formularza, a część ginie.',
  'Na marketing nie masz czasu, a agencje mówią językiem, którego nie rozumiesz.',
];

const services = [
  {
    icon: 'site',
    title: 'Strona, która sprzedaje',
    text: 'Szybka na telefonie, z jasnym „zadzwoń” i formularzem na wierzchu. Teksty piszę ja, Ty tylko poprawiasz. Hosting za 0 zł.',
  },
  {
    icon: 'ads',
    title: 'Google Ads pod zapytania',
    text: 'Kampanie ustawione tak, żeby płacić za klientów, a nie za kliknięcia. Wycinam frazy, które przepalają budżet, i co tydzień sprawdzam wydatki.',
  },
  {
    icon: 'ai',
    title: 'Widoczność w AI',
    text: 'Klienci coraz częściej pytają ChatGPT i Copilota, gdzie coś kupić. Przygotowuję stronę i dane o firmie tak, żeby AI polecało właśnie Ciebie.',
  },
  {
    icon: 'map',
    title: 'Google: wyszukiwarka i mapy',
    text: 'Profil firmy w Google, opinie, dane strukturalne i treści, które odpowiadają na pytania klientów. Tak budujesz ruch, za który nie płacisz co klik.',
  },
  {
    icon: 'inbox',
    title: 'Żadne zapytanie nie ginie',
    text: 'Prosty CRM w Arkuszach Google albo Notion: kto pytał, skąd przyszedł i komu trzeba oddzwonić. Powiadomienia na maila od razu.',
  },
  {
    icon: 'bolt',
    title: 'Automatyzacje',
    text: 'Powtarzalne rzeczy robią się same: raporty z reklam, prośby o opinię po realizacji, przepisywanie zapytań do arkusza.',
  },
] as const;

const steps = [
  { t: 'Rozmowa', d: '30 minut na miejscu albo przez telefon. Bezpłatnie.' },
  { t: 'Bezpłatny przegląd', d: 'Sprawdzam Twoją stronę, reklamy i widoczność w Google i AI. Mówię, co bym zmienił.' },
  { t: 'Propozycja na piśmie', d: 'Co robię, ile to kosztuje i czego potrzebuję od Ciebie. Bez drobnego druku.' },
  { t: 'Start i raport co miesiąc', d: 'Najpierw porządkuję pomiar. Potem 3. dnia każdego miesiąca dostajesz krótki raport: wydatki, zapytania, co zmieniam.' },
];

const faq = [
  {
    q: 'Czy muszę podpisać umowę na rok?',
    a: site.noLongContract
      ? 'Nie. Pracujemy miesiąc do miesiąca, z miesięcznym wypowiedzeniem. Zostajesz, bo widzisz wyniki, a nie dlatego, że musisz.'
      : 'Ustalamy to przy propozycji. Zawsze z jasnym okresem wypowiedzenia.',
  },
  {
    q: 'Ile muszę wydać na same reklamy?',
    a: 'Budżet reklam płacisz bezpośrednio Google, osobno od mojego wynagrodzenia. Dla lokalnej firmy usługowej sensowny start to ok. 300-450 zł miesięcznie: kampania tylko w wyszukiwarce, na najbardziej konkretne frazy i w Twojej okolicy. Przy kliknięciu za 2-3 zł to ok. 100-200 wejść klientów, którzy szukają dokładnie tego, co robisz. Mniej zwykle nie ma sensu, bo za mało danych, żeby cokolwiek ocenić.',
  },
  {
    q: 'Czyje jest konto reklamowe, domena i strona?',
    a: 'Twoje. Konto Google Ads, domena i kod strony są na Twoją firmę. Jeśli kiedyś się rozstaniemy, wszystko zostaje u Ciebie.',
  },
  {
    q: 'Co to jest widoczność w AI?',
    a: 'Coraz więcej osób zamiast w Google pyta ChatGPT, Copilota albo Gemini: „gdzie w okolicy zrobić…”, „kto produkuje…”. Te narzędzia polecają firmy, o których mają wiarygodne informacje. Dbam o to, żeby je miały: dane strukturalne na stronie, wpisy w bazach takich jak Wikidata, Bing i Google, treści odpowiadające na konkretne pytania. Art Papier jest dziś wymieniany przez ChatGPT, a Copilot cytował stronę 55 razy.',
  },
  {
    q: 'Co jeśli nie będzie wyników?',
    a: 'Zobaczysz to w raporcie, czarno na białym. Wtedy mówię wprost, co zmieniam albo że dany kanał się u Ciebie nie opłaca. Wolę stracić klienta niż brać pieniądze za coś, co nie działa.',
  },
  {
    q: 'Muszę się znać na marketingu?',
    a: 'Nie. Potrzebuję od Ciebie wiedzy o firmie i klientach, resztę biorę na siebie. Raport piszę tak, żeby dało się go przeczytać przy kawie.',
  },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base jsonLd={[faqLd]}>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">{site.personName} · {site.areaShort}</p>
        <h1>Więcej klientów z internetu. <span class="grad">Bez zajmowania się marketingiem.</span></h1>
        <p class="lead">
          Strona, reklamy Google i widoczność w AI dla małych firm. Robię to za Ciebie, a co miesiąc pokazuję, ile to
          kosztowało i ile zapytań przyniosło.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#kontakt">Umów bezpłatną rozmowę</a>
          <a class="btn btn-glass" href="#realizacje">Zobacz realizacje</a>
        </div>
        <p class="muted small trust">Jawne ceny{site.noLongContract && ' · Bez umowy na rok'} · Konta i strona należą do Ciebie</p>
      </div>

      <div class="hero-visual" aria-label="Przykładowe wyniki: Art Papier">
        <div class="dash glass">
          <div class="dash-head">
            <span class="dot"></span>
            <span class="small muted">Art Papier · Google Ads</span>
          </div>
          <p class="small muted label">Koszt jednego zapytania</p>
          <p class="big"><span class="old">75,80 zł</span> <span class="grad">33,29 zł</span></p>
          <svg viewBox="0 0 300 90" class="spark" aria-hidden="true">
            <defs>
              <linearGradient id="sg" x1="0" x2="1">
                <stop offset="0" stop-color="#f472b6"></stop>
                <stop offset="1" stop-color="#5eead4"></stop>
              </linearGradient>
              <linearGradient id="sf" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#5eead4" stop-opacity=".28"></stop>
                <stop offset="1" stop-color="#5eead4" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <path d="M0 14 C40 16 60 22 90 30 S150 58 180 64 S250 72 300 74 L300 90 L0 90Z" fill="url(#sf)"></path>
            <path d="M0 14 C40 16 60 22 90 30 S150 58 180 64 S250 72 300 74" fill="none" stroke="url(#sg)" stroke-width="3" stroke-linecap="round"></path>
          </svg>
          <p class="small muted caption">Październik 2026, dwa tygodnie po uporządkowaniu kampanii</p>
        </div>
        <div class="chip-float glass c1"><strong>15 dni</strong><span>od decyzji do działającego sklepu</span></div>
        <div class="chip-float glass c2"><strong>55×</strong><span>strona cytowana przez Copilota</span></div>
      </div>
    </div>

    <div class="marquee" aria-label="Firmy, dla których pracowałem">
      <div class="track">
        {[...names, ...names].map((n) => <span>{n}</span>)}
      </div>
    </div>
  </section>

  <!-- BRZMI ZNAJOMO -->
  <section class="pains">
    <div class="wrap">
      <div class="reveal center narrow">
        <p class="eyebrow">Brzmi znajomo?</p>
        <h2>Masz firmę do prowadzenia. Marketing nie powinien być drugim etatem.</h2>
      </div>
      <div class="grid grid-2 pain-grid">
        {
          pains.map((t) => (
            <div class="glass pain reveal">
              <span class="x" aria-hidden="true" />
              <p>{t}</p>
            </div>
          ))
        }
      </div>
      <p class="lead center narrow reveal answer">
        Biorę to na siebie: od strony, przez reklamy, po to, żeby każde zapytanie trafiło do kogoś, kto oddzwoni.
      </p>
    </div>
  </section>

  <!-- USŁUGI -->
  <section id="uslugi">
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">Co robię</p>
        <h2>Wszystko, czego potrzebujesz, żeby klient Cię znalazł i zadzwonił</h2>
        <p class="lead">Możesz wziąć jedną rzecz albo całość. Najlepiej działa razem, bo wtedy wiem, co naprawdę przynosi klientów.</p>
      </div>
      <div class="grid grid-3 services">
        {
          services.map((s) => (
            <article class="glass card reveal">
              <div class="icon">
                <Icon name={s.icon} />
              </div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- AI -->
  <section class="ai">
    <div class="wrap ai-grid">
      <div class="reveal">
        <p class="eyebrow">Nowość, której nie robi większość agencji</p>
        <h2>Twoi klienci pytają już <span class="grad">ChatGPT</span>. Czy poleca Ciebie?</h2>
        <p class="lead">
          Zamiast przeglądać dziesięć stron w Google, ludzie pytają AI: „gdzie kupić…”, „kto w Gdańsku robi…”. AI poleca
          firmy, o których ma pewne informacje. Moja robota to sprawić, żeby Twoja do nich należała.
        </p>
        <ul class="check">
          <li>Dane o firmie w miejscach, z których korzysta AI (Wikidata, Bing, Google)</li>
          <li>Strona z danymi strukturalnymi i odpowiedziami na pytania klientów</li>
          <li>Sprawdzanie co miesiąc, co AI mówi o Twojej firmie i o konkurencji</li>
        </ul>
      </div>
      <div class="ai-chat glass reveal" aria-label="Przykład: pytanie do ChatGPT">
        <div class="bubble me">Gdzie w Polsce kupić papier z nasionami z nadrukiem dla firmy?</div>
        <div class="bubble bot">
          <span class="small muted">ChatGPT</span>
          W odpowiedzi wymienia <strong>Seedpaper (ART-PAPIER)</strong> jako polskiego producenta papieru z nasionami.
        </div>
        <p class="small muted note">Sprawdzone 6.10.2026 (streszczenie odpowiedzi). Do tego 55 cytowań strony w Copilocie i wpis w Wikidata.</p>
      </div>
    </div>
  </section>

  <!-- REALIZACJE -->
  <section id="realizacje">
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">Realizacje</p>
        <h2>Co zrobiłem i co z tego wyszło</h2>
      </div>

      <article class="case reveal">
        <div class="case-media">
          <Showcase video={artPapier.video} label={artPapier.name} url={artPapier.url} />
        </div>
        <div class="case-text">
          <p class="tag">Strona · Sklep · Google Ads · AI</p>
          <h3>{artPapier.name}</h3>
          <p class="muted">{artPapier.tagline}</p>
          <div class="stats">
            {
              artPapier.stats?.map((s) => (
                <div class="stat glass">
                  <strong>{s.value}</strong>
                  <span>{s.label}</span>
                </div>
              ))
            }
          </div>
          <a class="btn btn-glass" href={artPapier.page}>Cała historia z liczbami →</a>
        </div>
      </article>

      <article class="case reverse reveal">
        <div class="case-media">
          <Showcase video={hc.video} label={hc.name} url={hc.url} />
        </div>
        <div class="case-text">
          <p class="tag">Strona · Marketing</p>
          <h3>{hc.name}</h3>
          <p class="muted">{hc.tagline}</p>
          <a class="btn btn-glass" href={hc.page}>Zobacz projekt →</a>
        </div>
      </article>

      <article class="case reveal">
        <div class="case-media">
          <Showcase video={agencySites[0].video} label={agencySites[0].name} />
        </div>
        <div class="case-text">
          <p class="tag">Wdrożenia stron</p>
          <h3>GiB Meble, Foto7, Prodvisor i inne</h3>
          <p class="muted">
            Strony, które wdrażałem w agencji marketingowej: animacje, rozbudowane menu, wersje na telefon. Projekt graficzny:
            agencja, kod: ja.
          </p>
          <a class="btn btn-glass" href="/strony/">Zobacz {agencySites.length} stron →</a>
        </div>
      </article>
    </div>
  </section>

  {
    quotes.length > 0 && (
      <section>
        <div class="wrap narrow">
          {quotes.map((q) => (
            <blockquote class="quote glass reveal">
              <p>„{q.text}”</p>
              <footer>
                <strong>{q.author}</strong>, {q.role}
              </footer>
            </blockquote>
          ))}
        </div>
      </section>
    )
  }

  <!-- JAK PRACUJĘ -->
  <section id="wspolpraca">
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">Jak pracuję</p>
        <h2>Od rozmowy do pierwszych zapytań</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="glass reveal">
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- CENY -->
  <section id="ceny">
    <div class="wrap">
      <div class="reveal center narrow">
        <p class="eyebrow">Ceny</p>
        <h2>Ceny wprost. Bez „wyceny indywidualnej”.</h2>
        <p class="lead">Wiesz od razu, na czym stoisz. Dokładny zakres ustalamy po rozmowie.</p>
      </div>
      <div class="grid grid-3 prices">
        <article class="glass card price-card reveal">
          <h3>Strona internetowa</h3>
          <p class="price">{p.website}<small>{priceSuffix}, jednorazowo</small></p>
          <ul class="check">
            <li>Projekt, teksty i wdrożenie</li>
            <li>Szybka na telefonie, gotowa pod reklamy</li>
            <li>Hosting za 0 zł, płacisz tylko za domenę</li>
            <li>Strona i domena są Twoje</li>
          </ul>
          <a class="btn btn-glass" href="#kontakt">Zapytaj o stronę</a>
        </article>
        <article class="glass card price-card featured reveal">
          <span class="badge">Tu widać efekty</span>
          <h3>Marketing co miesiąc</h3>
          <p class="price">{p.marketing}<small>{priceSuffix}</small></p>
          <ul class="check">
            <li>Google Ads prowadzone na bieżąco</li>
            <li>Profil firmy w Google i widoczność w AI</li>
            <li>Raport co miesiąc: wydatki i zapytania</li>
            <li>Zmiany na stronie w cenie</li>
          </ul>
          <a class="btn btn-primary" href="#kontakt">Porozmawiajmy</a>
          <p class="muted small fine">Budżet reklam płacisz bezpośrednio Google: {p.adBudget}</p>
        </article>
        <article class="glass card price-card reveal">
          <h3>Porządek z zapytaniami</h3>
          <p class="price">
            {
              p.crm ? (
                <>
                  {p.crm}
                  <small>{priceSuffix}</small>
                </>
              ) : (
                <>
                  po rozmowie<small>zależy od liczby źródeł zapytań</small>
                </>
              )
            }
          </p>
          <ul class="check">
            <li>CRM w Arkuszach Google albo Notion</li>
            <li>Powiadomienia o nowych zapytaniach</li>
            <li>Automatyczne raporty i przypomnienia</li>
            <li>Szkolenie dla osoby w biurze</li>
          </ul>
          <a class="btn btn-glass" href="#kontakt">Zapytaj</a>
        </article>
      </div>
      <p class="center muted small reveal guarantee">
        {site.noLongContract && 'Bez umowy na rok, z miesięcznym wypowiedzeniem. '}Konto reklamowe, domena i strona zawsze
        należą do Ciebie.
      </p>
    </div>
  </section>

  <!-- O MNIE -->
  <section id="o-mnie">
    <div class="wrap about">
      <div class="portrait reveal">
        {
          site.photo ? (
            <img src={site.photo} alt={site.personName} width="560" height="560" loading="lazy" />
          ) : (
            <div class="portrait-ph" aria-hidden="true">
              AC
            </div>
          )
        }
      </div>
      <div class="reveal">
        <p class="eyebrow">O mnie</p>
        <h2>Programista, który zaczynał w marketingu</h2>
        <p class="lead">
          Mam na imię Olek. Od ponad 6 lat piszę strony i aplikacje. Pierwszą pracę miałem w agencji marketingowej, więc od
          początku patrzę na dwie rzeczy naraz: czy strona działa i czy z reklamy dzwoni klient.
        </p>
        <p class="muted">
          Pracuję z kilkoma firmami, nie z setką, więc znam Twoją kampanię, a nie tylko numer klienta. Powtarzalną robotę
          automatyzuję, także z pomocą AI. Dzięki temu dostajesz efekt małego zespołu w cenie jednej osoby, a decyzje i
          kontakt z Tobą zostają po mojej stronie.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="wrap narrow">
      <div class="reveal">
        <p class="eyebrow">Pytania</p>
        <h2>Zanim zapytasz</h2>
      </div>
      {
        faq.map((f) => (
          <details class="glass reveal">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <Contact />
</Base>

<style>
  /* HERO */
  .hero {
    padding-top: clamp(48px, 8vw, 110px);
    padding-bottom: 40px;
  }
  .hero-grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1.25fr 1fr;
    }
  }
  .hero h1 {
    margin-bottom: 0.4em;
  }
  .hero .lead {
    max-width: 600px;
    margin-bottom: 1.6em;
  }
  .trust {
    margin-top: 20px;
  }
  .hero-visual {
    position: relative;
    padding: 30px 0 40px;
  }
  .dash {
    padding: 26px 26px 22px;
    max-width: 420px;
    margin-left: auto;
    transform: perspective(1200px) rotateY(-6deg) rotateX(3deg);
  }
  .dash-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 10px var(--teal);
  }
  .label {
    margin: 0;
  }
  .big {
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    margin: 4px 0 8px;
    line-height: 1.1;
  }
  .old {
    font-size: 0.5em;
    color: var(--text-3);
    text-decoration: line-through;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .caption {
    margin: 0;
    max-width: 62%;
    margin-left: auto;
    text-align: right;
  }
  .spark {
    width: 100%;
    height: auto;
    margin: 6px 0 10px;
  }
  .chip-float {
    position: absolute;
    padding: 14px 18px;
    border-radius: 20px;
    display: grid;
    max-width: 210px;
    animation: float 7s ease-in-out infinite;
  }
  .chip-float strong {
    font-size: 1.5rem;
    letter-spacing: -0.03em;
  }
  .chip-float span {
    font-size: 0.82rem;
    color: var(--text-2);
    line-height: 1.35;
  }
  .c1 {
    left: -8px;
    top: 46%;
  }
  .c2 {
    right: -14px;
    top: 0;
    animation-delay: -3.5s;
  }
  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }
  @media (max-width: 979px) {
    .dash {
      margin-inline: auto;
      transform: none;
    }
    .c1 {
      left: 0;
    }
    .c2 {
      right: 0;
    }
  }
  @media (max-width: 560px) {
    .chip-float {
      position: static;
      max-width: none;
      animation: none;
      margin-top: 12px;
    }
    .hero-visual {
      padding: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .chip-float {
      animation: none;
    }
  }

  .marquee {
    margin-top: clamp(48px, 7vw, 88px);
    overflow: hidden;
    -webkit-mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .track {
    display: flex;
    gap: 56px;
    width: max-content;
    animation: scroll 40s linear infinite;
  }
  .track span {
