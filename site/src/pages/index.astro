---
import Base from '../layouts/Base.astro';
import Showcase from '../components/Showcase.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import { site, priceSuffix } from '../config/site';
import { featured, agencySites, quotes } from '../data/projects';

const artPapier = featured[0];
const hc = featured[1];
const p = site.prices;

const logos = [
  { file: 'art-papier', w: 137, name: 'Art Papier', h: 60 },
  { file: 'hc-instal', w: 704, name: 'HC INSTAL', h: 22 },
  { file: 'gib-meble', w: 302, name: 'GiB Meble', h: 38 },
  { file: 'foto7', w: 352, name: 'Foto7', h: 30 },
  { file: 'prodvisor', w: 703, name: 'Prodvisor', h: 22 },
  { file: 'auto-centrum', w: 271, name: 'Auto-Centrum', h: 40 },
  { file: 'vibeon', w: 112, name: 'vibeOn', h: 44 },
  { file: 'liberta', w: 340, name: 'Liberta Okna', h: 32 },
];

const pains = [
  'Płacisz za reklamy, ale nie wiesz, ile zapytań z nich masz?',
  'Strona ma kilka lat, wolno działa na telefonie i nikt z niej nie dzwoni?',
  'Zapytania przychodzą mailem, telefonem i z formularza, a część z nich ginie?',
  'Nie masz czasu na marketing, a agencje mówią językiem, którego nie rozumiesz?',
];

const whole = [
  {
    icon: 'chart',
    title: 'Analiza firmy',
    text: 'Patrzę, co robisz, jak to robisz i co możesz robić lepiej. Kim są Twoi klienci i jak się z nimi kontaktujesz.',
  },
  {
    icon: 'doc',
    title: 'Oferta',
    text: 'Pomagam ułożyć ofertę tak, żeby łatwiej się sprzedawała: pakiety, promocje sezonowe, jasny cennik.',
  },
  {
    icon: 'chat',
    title: 'Sprzedaż',
    text: 'Przygotuję bazę klientów z asystentem, który przypomina o kontakcie, i prosty proces obsługi zapytań. Pomogę też wdrożyć skuteczne telefony do nowych klientów.',
  },
  {
    icon: 'rocket',
    title: 'Marketing',
    text: 'Dopiero na tym budujemy stronę, reklamy i widoczność w Google i AI. Wtedy każda złotówka trafia tam, gdzie przynosi klientów.',
  },
] as const;

const services = [
  {
    icon: 'site',
    title: 'Szybka strona na darmowym hostingu',
    text: 'Strona szybka na telefonie, z jasnym „zadzwoń” i formularzem. Teksty piszę ja. Płacisz raz za wykonanie i co rok tylko za domenę. <strong>Hosting 0 zł.</strong>',
  },
  {
    icon: 'ads',
    title: 'Google Ads pod zapytania',
    text: 'Kampanie ustawione tak, żeby płacić za klientów, a nie za kliknięcia. Wycinam frazy, które przepalają budżet, a wydatki sprawdzam co tydzień.',
  },
  {
    icon: 'ai',
    title: 'Widoczność w ChatGPT i AI',
    text: 'Klienci coraz częściej pytają ChatGPT, gdzie coś kupić. Sprawiam, że AI poleca Twoją firmę, <strong>bez płacenia za reklamy w ChatGPT</strong>. Kampanie w ChatGPT też możemy uruchomić, ale dziś równie dobre wyniki osiągam bez nich.',
  },
  {
    icon: 'map',
    title: 'Google: wyszukiwarka i mapy',
    text: 'Profil firmy w Google, opinie i treści, które odpowiadają na pytania klientów. Ruch, za który nie płacisz za każde kliknięcie.',
  },
  {
    icon: 'inbox',
    title: 'Baza klientów',
    text: 'Jedno miejsce, w którym widzisz, kto pytał, skąd przyszedł i komu trzeba oddzwonić. Nowe zapytania trafiają tam same, a Ty dostajesz powiadomienie.',
  },
  {
    icon: 'bolt',
    title: 'Automatyzacje',
    text: 'Załatwię to, że po realizacji klienci sami dostaną prośbę o opinię w Google, zapytania same zapiszą się w bazie klientów, a raport z reklam sam przyjdzie na maila.',
  },
] as const;

const team = [
  { t: 'Graficy', d: 'logo, materiały reklamowe, grafiki do kampanii' },
  { t: 'Fotografowie', d: 'zdjęcia produktów, ludzi i realizacji' },
  { t: 'Filmowcy i twórcy TikTok', d: 'krótkie filmy i reklamy do social mediów' },
  { t: 'Osoby od telefonów', d: 'umawianie spotkań i dzwonienie do nowych klientów' },
  { t: 'Narzędzia AI', d: 'analiza danych, raporty i teksty szybciej i taniej' },
];

const steps = [
  { t: 'Rozmowa', d: '30 minut przez telefon albo na miejscu. Bezpłatnie.' },
  { t: 'Bezpłatny przegląd', d: 'Sprawdzam Twoją stronę, reklamy, ofertę i to, jak obsługujesz zapytania. Mówię, co bym zmienił.' },
  { t: 'Plan na piśmie', d: 'Co robię, w jakiej kolejności, ile to kosztuje i czego potrzebuję od Ciebie.' },
  { t: 'Stała opieka', d: 'Pracuję, doglądam i doradzam co tydzień. 3. dnia miesiąca dostajesz krótki raport: wydatki, zapytania, co zmieniam.' },
];

const faq = [
  {
    q: 'Ile muszę wydać na same reklamy?',
    a: 'Budżet reklam płacisz bezpośrednio Google, osobno od mojego wynagrodzenia. Dla lokalnej firmy usługowej sensowny start to ok. 300-450 zł miesięcznie: kampania tylko w wyszukiwarce, na najbardziej konkretne frazy i w Twojej okolicy. Przy kliknięciu za 2-3 zł to ok. 100-200 wejść osób, które szukają dokładnie tego, co robisz. Mniej zwykle nie ma sensu, bo za mało danych, żeby cokolwiek ocenić.',
  },
  {
    q: 'Czyje jest konto reklamowe, domena i strona?',
    a: 'Twoje. Konto Google Ads, domena i kod strony są na Twoją firmę. Jeśli kiedyś się rozstaniemy, wszystko zostaje u Ciebie.',
  },
  {
    q: 'Jak to możliwe, że hosting jest za darmo?',
    a: 'Strony robię w nowoczesnej technologii (Astro), która działa na globalnej sieci Cloudflare. Dla stron firmowych ich darmowy plan w zupełności wystarcza, a strona ładuje się błyskawicznie. Płacisz tylko za domenę, zwykle kilkadziesiąt złotych rocznie.',
  },
  {
    q: 'Czym jest widoczność w ChatGPT?',
    a: 'Coraz więcej osób zamiast w Google pyta ChatGPT, Copilota albo Gemini: „gdzie w okolicy zrobić…”, „kto produkuje…”. Te narzędzia polecają firmy, o których mają wiarygodne informacje. Dbam o to, żeby je miały: dane na stronie, wpisy w bazach, z których korzysta AI, i treści odpowiadające na konkretne pytania klientów.',
  },
  {
    q: 'Dlaczego tylko 3 firmy naraz?',
    a: 'Bo chcę być Twoim działem marketingu i rozwoju, a nie wykonawcą, który zrobi stronę i zniknie. Przy trzech firmach znam każdą kampanię, każdy problem i każdą liczbę.',
  },
  {
    q: 'Co jeśli nie będzie wyników?',
    a: 'Zobaczysz to w raporcie, czarno na białym. Wtedy mówię wprost, co zmieniam albo że dany kanał się u Ciebie nie opłaca. Wolę stracić klienta niż brać pieniądze za coś, co nie działa.',
  },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base jsonLd={[faqLd]}>
  <!-- HERO -->
  <section class="hero" data-flow>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <div class="intro">
          {
            site.avatar && (
              <img src={site.avatar} alt={site.personName} width="112" height="112" decoding="async" />
            )
          }
          <p>
            <strong>{site.personName}</strong>
            <span>marketing i rozwój małych i średnich przedsiębiorstw</span>
          </p>
        </div>
        <h1>Więcej klientów z internetu. <span class="grad">Marketing masz z&nbsp;głowy.</span></h1>
        <p class="lead">
          Strona, reklamy Google, widoczność w ChatGPT i porządek w sprzedaży. Biorę to na siebie i co miesiąc pokazuję, ile to
          kosztowało i ile przyniosło.
        </p>
        <div class="hosting glass">
          <span class="hosting-ico" aria-hidden="true"><Icon name="bolt" /></span>
          <p>
            Szybka strona, <strong>hosting za 0&nbsp;zł.</strong> Płacisz raz {p.website}{priceSuffix} za wykonanie, a potem co rok
            tylko za domenę.
          </p>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href="#kontakt">Umów bezpłatną rozmowę</a>
          {
            site.phone ? (
              <a class="btn btn-glass" href={`tel:${site.phoneHref || site.phone}`}>
                {site.phone}
              </a>
            ) : (
              <a class="btn btn-glass" href="#realizacje">
                Zobacz realizacje
              </a>
            )
          }
        </div>
      </div>

      <div class="hero-visual" aria-label="Przykładowe wyniki: Art Papier, Google Ads">
        <div class="dash glass">
          <div class="dash-head">
            <span class="dot"></span>
            <span class="small muted">Art Papier · Google Ads</span>
          </div>
          <div class="kpis">
            <div>
              <p class="small muted label"><i class="key red"></i>Koszt zapytania</p>
              <p class="big red">33,29 zł</p>
              <p class="delta down">↓ z 75,80 zł</p>
            </div>
            <div>
              <p class="small muted label"><i class="key green"></i>Zapytania z reklam</p>
              <p class="big green">20</p>
              <p class="delta up">↑ z 14</p>
            </div>
          </div>
          <!-- Wykres poglądowy (na prośbę Olka 26.11.2026): koszt zapytania (czerwony) spada, liczba zapytań (zielony)
               rośnie od zera; linie się przecinają. Liczby obok są z eksportu Art Papier. -->
          <svg viewBox="0 0 300 100" class="spark" aria-hidden="true">
            <defs>
              <linearGradient id="fr" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#fb7185" stop-opacity=".22"></stop>
                <stop offset="1" stop-color="#fb7185" stop-opacity="0"></stop>
              </linearGradient>
              <linearGradient id="fg" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#4ade80" stop-opacity=".25"></stop>
                <stop offset="1" stop-color="#4ade80" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <g stroke="rgb(255 255 255 / 8%)" stroke-width="1">
              <line x1="0" y1="25" x2="300" y2="25"></line>
              <line x1="0" y1="50" x2="300" y2="50"></line>
              <line x1="0" y1="75" x2="300" y2="75"></line>
            </g>
            <path d="M0 12 C60 14 100 30 150 52 S240 80 300 84 L300 100 L0 100Z" fill="url(#fr)"></path>
            <path d="M0 98 C60 96 100 80 150 52 S240 30 300 28 L300 100 L0 100Z" fill="url(#fg)"></path>
            <path class="line" pathLength="1" d="M0 12 C60 14 100 30 150 52 S240 80 300 84" fill="none" stroke="#fb7185" stroke-width="3" stroke-linecap="round"></path>
            <path class="line" pathLength="1" d="M0 98 C60 96 100 80 150 52 S240 30 300 28" fill="none" stroke="#4ade80" stroke-width="3" stroke-linecap="round"></path>
            <circle cx="300" cy="84" r="4" fill="#fb7185"></circle>
            <circle cx="300" cy="28" r="4" fill="#4ade80"></circle>
          </svg>
          <p class="small muted caption">Koszt: 6-19.10 → 20-31.10.2026. Zapytania: 6-31.10 → 20.10-18.11.2026.</p>
        </div>
        <div class="chip-float glass c1"><strong>5 dni</strong><span>tyle zajęło zbudowanie sklepu</span></div>
        <div class="chip-float glass c2"><strong>55×</strong><span>tyle razy AI zacytowało stronę w odpowiedziach</span></div>
      </div>
    </div>

    <div class="marquee" aria-label="Firmy, dla których pracowałem">
      <div class="track">
        {
          [...logos, ...logos].map((l, i) => (
            <img
              src={`/logos/${l.file}.webp`}
              alt={i < logos.length ? l.name : ''}
              aria-hidden={i >= logos.length ? 'true' : undefined}
              width={Math.round((l.w * l.h) / 96)}
              height={l.h}
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- PYTANIA -->
  <section class="pains" data-flow>
    <div class="wrap">
      <div class="reveal center narrow">
        <p class="eyebrow">Brzmi znajomo?</p>
        <h2>Masz firmę do prowadzenia. Marketing nie powinien być drugim etatem.</h2>
      </div>
      <div class="grid grid-2 pain-grid">
        {
          pains.map((t) => (
            <div class="glass pain reveal">
              <span class="q" aria-hidden="true">?</span>
              <p>{t}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CAŁA FIRMA -->
  <section class="whole" data-flow>
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">Więcej niż marketing</p>
        <h2>Zajmuję się Twoją firmą <span class="grad">kompleksowo</span></h2>
        <p class="lead">
          Reklama nie pomoże, jeśli oferta jest niejasna, a zapytania czekają tydzień na odpowiedź. Dlatego zaczynam od całej
          firmy, a dopiero potem włączam marketing.
        </p>
      </div>
      <ol class="whole-grid">
        {
          whole.map((w, i) => (
            <li class="glass card reveal">
              <div class="whole-top">
                <div class="icon">
                  <Icon name={w.icon} />
                </div>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- USŁUGI -->
  <section id="uslugi" data-flow>
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">Co dla Ciebie zrobię</p>
        <h2>Wszystko, żeby klient Cię znalazł, zapytał i kupił</h2>
      </div>
      <div class="grid grid-3 services">
        {
          services.map((s) => (
            <article class="glass card reveal">
              <div class="icon">
                <Icon name={s.icon} />
              </div>
              <h3>{s.title}</h3>
              <p set:html={s.text} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- MAKS. 3 FIRMY + ZAPLECZE -->
  <section class="focus" data-flow>
    <div class="wrap focus-grid">
      <div class="focus-main glass reveal">
        <p class="three grad" aria-hidden="true">{site.maxClients}</p>
        <h2>Pracuję maksymalnie z {site.maxClients} firmami naraz</h2>
        <p class="lead">
          Nie robię jednorazowej roboty, po której zostajesz sam. Jestem Twoim działem marketingu i rozwoju: cały czas
          doglądam, pracuję, doradzam i obserwuję wyniki.
        </p>
        <ul class="check">
          <li>Znam Twoją firmę, klientów i każdą kampanię</li>
          <li>Reaguję, zanim mały problem zje budżet</li>
          <li>Proponuję kolejne kroki, zanim o nie zapytasz</li>
        </ul>
      </div>
      <div class="team reveal">
        <p class="eyebrow">Moje zaplecze</p>
        <h3 class="team-h">Gdy projekt tego wymaga, angażuję sprawdzonych ludzi</h3>
        <ul class="team-list">
          {
            team.map((m) => (
              <li class="glass">
                <strong>{m.t}</strong>
                <span>{m.d}</span>
              </li>
            ))
          }
        </ul>
        <p class="muted small">Ty masz jedną osobę kontaktową: mnie. Ja koordynuję resztę.</p>
      </div>
    </div>
  </section>

  <!-- REALIZACJE -->
  <section id="realizacje" data-flow>
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">Realizacje</p>
        <h2>Co zrobiłem i co z tego wyszło</h2>
      </div>

      <div class="cases">
        <article class="case-card glass reveal">
          <Showcase video={artPapier.video} label={artPapier.name} url={artPapier.url} eager />
          <div class="case-body">
            <p class="tag">Strona · Sklep · Google Ads · AI · Baza klientów</p>
            <h3>Art Papier</h3>
            <p class="muted">Czerpalnia papieru z nasionami. Koszt zapytania z reklam spadł ponad dwa razy, a firma jest polecana przez ChatGPT.</p>
            <a class="btn btn-glass" href={artPapier.page}>Zobacz case study →</a>
          </div>
        </article>
        <article class="case-card glass reveal">
          <Showcase video={hc.video} label={hc.name} url={hc.url} eager />
          <div class="case-body">
            <p class="tag">Strona · Sklep · Marketing</p>
            <h3>HC INSTAL</h3>
            <p class="muted">Automatyka budynkowa i elektryka. Sklep z magazynami energii, dzięki któremu firma sprzedaje je na polskim rynku.</p>
            <a class="btn btn-glass" href={hc.page}>Zobacz projekt →</a>
          </div>
        </article>
      </div>

      <div class="carousel-head reveal">
        <div>
          <h3>Strony, które wdrażałem</h3>
          <p class="muted small">Projekt graficzny: agencja marketingowa, kod i animacje: ja.</p>
        </div>
        <div class="carousel-nav">
          <button class="btn btn-glass nav-btn" data-dir="-1" aria-label="Poprzednia strona">←</button>
          <button class="btn btn-glass nav-btn" data-dir="1" aria-label="Następna strona">→</button>
        </div>
      </div>
      <div class="carousel" id="karuzela" tabindex="0" aria-label="Strony wdrożone w agencji">
        {
          agencySites.map((s) => (
            <figure class:list={['slide', { pair: s.video2 }]}>
              <div class="slide-media">
                <Showcase video={s.video} label={s.name} mobile={false} />
                {s.video2 && <Showcase video={s.video2} label={`${s.name}, podstrona`} mobile={false} />}
              </div>
              <figcaption>
                <strong>{s.name}</strong>
                <span class="muted small">{s.tagline}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
      <div class="more reveal">
        <a class="btn btn-glass more-btn" href="/strony/">Zobacz więcej <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- REFERENCJE -->
  {
    quotes.length > 0 && (
      <section data-flow>
        <div class="wrap">
          <div class="reveal narrow">
            <p class="eyebrow">Referencje</p>
            <h2>Co mówią klienci</h2>
          </div>
          <div class="grid grid-2 quotes">
            {quotes.map((q) => (
              <blockquote class="quote glass reveal">
                {q.draft && <span class="draft">przykład, do podmiany</span>}
                <p>„{q.text}”</p>
                <footer>
                  <strong>{q.author}</strong>
                  <span>{q.role}</span>
                </footer>
              </blockquote>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- JAK PRACUJĘ -->
  <section id="wspolpraca" data-flow>
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">Jak pracuję</p>
        <h2>Od rozmowy do stałej opieki</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="glass reveal">
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- CENY -->
  <section id="ceny" data-flow>
    <div class="wrap">
      <div class="reveal center narrow">
        <p class="eyebrow">Ceny</p>
        <h2>Ceny wprost. Bez „wyceny indywidualnej”.</h2>
      </div>
      <div class="grid grid-3 prices">
        <article class="glass card price-card reveal">
          <h3>Strona internetowa</h3>
          <p class="price">{p.website}<small>{priceSuffix}, jednorazowo</small></p>
          <ul class="check">
            <li><strong>Hosting 0 zł</strong>, płacisz tylko za domenę</li>
            <li>Projekt, teksty i wdrożenie</li>
            <li>Szybka na telefonie, gotowa pod reklamy</li>
            <li>Formularz kontaktowy i podstawy SEO</li>
          </ul>
          <a class="btn btn-glass" href="#kontakt">Zapytaj o stronę</a>
        </article>
        <article class="glass card price-card featured reveal">
          <span class="badge">Stała opieka</span>
          <h3>Marketing i rozwój firmy</h3>
          <p class="price">{p.marketing}<small>{priceSuffix} · {p.marketingTime}</small></p>
          <ul class="check">
            <li>Analiza firmy, oferty i klientów</li>
            <li>Google Ads prowadzone na bieżąco</li>
            <li>Widoczność w ChatGPT, Google i mapach</li>
            <li>Baza klientów i proces obsługi zapytań</li>
            <li>Pomysły na pakiety i promocje</li>
            <li>Automatyzacje: opinie, raporty, powiadomienia</li>
            <li>Zmiany na stronie w cenie</li>
            <li>Raport co miesiąc</li>
          </ul>
          <a class="btn btn-primary" href="#kontakt">Porozmawiajmy</a>
          <p class="muted small fine">Budżet reklam płacisz bezpośrednio Google: {p.adBudget}</p>
        </article>
        <article class="glass card price-card reveal">
