---
// Strona główna w dwóch językach (pages/index.astro i pages/en/index.astro).
// Teksty: T('polski', 'English') – poprawiając tekst, popraw od razu oba języki.
import Base from '../layouts/Base.astro';
import Showcase from '../components/Showcase.astro';
import Contact from '../components/Contact.astro';
import Icon from '../components/Icon.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { site, prices } from '../config/site';
import { featured, agencySites, quotes } from '../data/projects';
import { type Lang, tr, href } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const T = tr(lang);
const en = lang === 'en';
const phoneShown = en ? `+48 ${site.phone}` : site.phone;

// Szkice opinii (draft: true) nie trafiają na stronę, dopóki klienci nie zaakceptują prawdziwych słów
// (decyzja przed indeksowaniem, 26.11.2026). Sekcja wraca sama, gdy jest choć jedna prawdziwa opinia.
const shownQuotes = quotes.filter((q) => !q.draft);

const artPapier = featured[0];
const hc = featured[1];
const p = prices(lang);
const priceSuffix = p.suffix;

const logos = [
  { file: 'art-papier', w: 137, name: 'Art Papier', h: 60 },
  { file: 'hc-instal', w: 704, name: 'HC INSTAL', h: 22 },
  { file: 'gib-meble', w: 302, name: 'GiB Meble', h: 38 },
  { file: 'foto7', w: 352, name: 'Foto7', h: 30 },
  { file: 'prodvisor', w: 703, name: 'Prodvisor', h: 22 },
  { file: 'auto-centrum', w: 271, name: 'Auto-Centrum', h: 40 },
  { file: 'vibeon', w: 112, name: 'vibeOn', h: 44 },
  { file: 'liberta', w: 340, name: 'Liberta Okna', h: 32 },
];

const pains = [
  T(
    'Płacisz za reklamy, ale nie wiesz, ile zapytań z nich masz?',
    'You pay for ads, but you don’t know how many enquiries they bring?',
  ),
  T(
    'Strona ma kilka lat, wolno działa na telefonie i nikt z niej nie dzwoni?',
    'Your website is a few years old, slow on phones, and nobody calls from it?',
  ),
  T(
    'Zapytania przychodzą mailem, telefonem i z formularza, a część z nich ginie?',
    'Enquiries come by email, phone and web form, and some of them get lost?',
  ),
  T(
    'Nie masz czasu na marketing, a agencje mówią językiem, którego nie rozumiesz?',
    'You have no time for marketing, and agencies speak a language you don’t understand?',
  ),
];

const whole = [
  {
    icon: 'chart',
    title: T('Analiza firmy', 'Business analysis'),
    text: T(
      'Patrzę, co robisz, jak to robisz i co możesz robić lepiej. Kim są Twoi klienci i jak się z nimi kontaktujesz.',
      'I look at what you do, how you do it and what you could do better. Who your customers are and how you reach them.',
    ),
  },
  {
    icon: 'doc',
    title: T('Oferta', 'Offer'),
    text: T(
      'Pomagam ułożyć ofertę tak, żeby łatwiej się sprzedawała: pakiety, promocje sezonowe, jasny cennik.',
      'I help you shape your offer so it sells more easily: packages, seasonal promotions, clear pricing.',
    ),
  },
  {
    icon: 'chat',
    title: T('Sprzedaż', 'Sales'),
    text: T(
      'Przygotuję bazę klientów z asystentem, który przypomina o kontakcie, i prosty proces obsługi zapytań. Pomogę też wdrożyć skuteczne telefony do nowych klientów.',
      'I set up a customer database with an assistant that reminds you to follow up, and a simple process for handling enquiries. I also help you introduce effective calls to new customers.',
    ),
  },
  {
    icon: 'rocket',
    title: 'Marketing',
    text: T(
      'Dopiero na tym budujemy stronę, reklamy i widoczność w Google i AI. Wtedy każda złotówka trafia tam, gdzie przynosi klientów.',
      'Only then do we build the website, ads and visibility in Google and AI. That way every złoty goes where it brings customers.',
    ),
  },
] as const;

const services = [
  {
    icon: 'site',
    title: T('Szybka strona na darmowym hostingu', 'A fast website on free hosting'),
    text: T(
      'Strona szybka na telefonie, z jasnym „zadzwoń” i formularzem. Teksty piszę ja. Płacisz raz za wykonanie i co rok tylko za domenę. <strong>Hosting 0 zł.</strong>',
      'A website that is fast on phones, with a clear “call me” and a contact form. I write the copy. You pay once for the build and then only for the domain each year. <strong>Hosting: PLN 0.</strong>',
    ),
  },
  {
    icon: 'ads',
    title: T('Google Ads pod zapytania', 'Google Ads that bring enquiries'),
    text: T(
      'Kampanie ustawione tak, żeby płacić za klientów, a nie za kliknięcia. Wycinam frazy, które przepalają budżet, a wydatki sprawdzam co tydzień.',
      'Campaigns set up so you pay for customers, not for clicks. I cut keywords that burn the budget and check spending every week.',
    ),
  },
  {
    icon: 'ai',
    title: T('Widoczność w ChatGPT i AI', 'Visibility in ChatGPT and AI'),
    text: T(
      'Klienci coraz częściej pytają ChatGPT, gdzie coś kupić. Sprawiam, że AI poleca Twoją firmę, <strong>bez płacenia za reklamy w ChatGPT</strong>. Kampanie w ChatGPT też możemy uruchomić, ale dziś równie dobre wyniki osiągam bez nich.',
      'More and more customers ask ChatGPT where to buy something. I make AI recommend your business, <strong>without paying for ads in ChatGPT</strong>. We can run ChatGPT campaigns too, but today I get equally good results without them.',
    ),
  },
  {
    icon: 'map',
    title: T('Google: wyszukiwarka i mapy', 'Google: search and maps'),
    text: T(
      'Profil firmy w Google, opinie i treści, które odpowiadają na pytania klientów. Ruch, za który nie płacisz za każde kliknięcie.',
      'Your Google Business Profile, reviews and content that answers customers’ questions. Traffic you don’t pay for per click.',
    ),
  },
  {
    icon: 'inbox',
    title: T('Baza klientów', 'Customer database'),
    text: T(
      'Jedno miejsce, w którym widzisz, kto pytał, skąd przyszedł i komu trzeba oddzwonić. Nowe zapytania trafiają tam same, a Ty dostajesz powiadomienie.',
      'One place where you see who asked, where they came from and who needs a call back. New enquiries land there automatically and you get a notification.',
    ),
  },
  {
    icon: 'bolt',
    title: T('Automatyzacje', 'Automations'),
    text: T(
      'Załatwię to, że po realizacji klienci sami dostaną prośbę o opinię w Google, zapytania same zapiszą się w bazie klientów, a raport z reklam sam przyjdzie na maila.',
      'I make sure customers automatically get a request for a Google review after the job, enquiries save themselves in the customer database, and the ads report arrives in your inbox on its own.',
    ),
  },
] as const;

// Wsparcie IT i własne narzędzia (na prośbę Olka 26.11.2026).
const itCards = [
  {
    icon: 'chat',
    title: T('Bieżące wsparcie IT', 'Ongoing IT support'),
    text: T(
      'Nie działa poczta, wysyłka paczek albo aplikacja, z której korzysta Twoja firma? Dzwonisz do mnie. Jestem doświadczonym programistą i zawsze znajdę rozwiązanie.',
      'Email, parcel shipping or an app your business relies on stopped working? You call me. I am an experienced developer and I always find a solution.',
    ),
  },
  {
    icon: 'bolt',
    title: T('Narzędzia szyte na miarę', 'Tailor-made tools'),
    text: T(
      'Masz dużo powtarzalnej roboty? Dogadamy się, a ja zrobię narzędzie albo automatyzację dopasowaną do Twojej firmy, które zrobi to za Ciebie.',
      'Lots of repetitive work? We agree on what you need and I build a tool or automation tailored to your business that does it for you.',
    ),
  },
  {
    icon: 'doc',
    title: T('Przykład: kosztorysy z hurtowni', 'Example: cost estimates from wholesalers'),
    text: T(
      'Stworzyłem rozszerzenie do przeglądarki, które tworzy kosztorys prosto ze stron hurtowni. Zamiast przepisywać produkty i ceny ręcznie, kosztorys składa się kilkoma kliknięciami.',
      'I built a browser extension that creates a cost estimate straight from wholesalers’ websites. Instead of copying products and prices by hand, the estimate comes together in a few clicks.',
    ),
  },
] as const;

const team = [
  { t: T('Graficy', 'Graphic designers'), d: T('logo, materiały reklamowe, grafiki do kampanii', 'logos, promotional materials, campaign graphics') },
  { t: T('Fotografowie', 'Photographers'), d: T('zdjęcia produktów, ludzi i realizacji', 'photos of products, people and finished projects') },
  {
    t: T('Filmowcy i twórcy TikTok', 'Videographers and TikTok creators'),
    d: T('krótkie filmy i reklamy do social mediów', 'short videos and ads for social media'),
  },
  {
    t: T('Specjaliści od sprzedaży przez telefon', 'Phone sales specialists'),
    d: T('budowanie relacji z nowymi klientami i umawianie spotkań', 'building relationships with new customers and booking meetings'),
  },
  { t: T('Agenci AI', 'AI agents'), d: T('analiza danych, raporty i teksty szybciej i taniej', 'data analysis, reports and copy, faster and cheaper') },
];

const steps = [
  { t: T('Rozmowa', 'A call'), d: T('30 minut przez telefon albo na miejscu. Bezpłatnie.', '30 minutes by phone or in person. Free of charge.') },
  {
    t: T('Bezpłatny przegląd', 'Free review'),
    d: T(
      'Sprawdzam Twoją stronę, reklamy, ofertę i to, jak obsługujesz zapytania. Mówię, co bym zmienił.',
      'I check your website, ads, offer and how you handle enquiries. I tell you what I would change.',
    ),
  },
  {
    t: T('Plan na piśmie', 'A written plan'),
    d: T(
      'Co robię, w jakiej kolejności, ile to kosztuje i czego potrzebuję od Ciebie.',
      'What I do, in what order, what it costs and what I need from you.',
    ),
  },
  {
    t: T('Stała opieka', 'Ongoing care'),
    d: T(
      'Pracuję, doglądam i doradzam co tydzień. 3. dnia miesiąca dostajesz krótki raport: wydatki, zapytania, co zmieniam.',
      'I work, monitor and advise every week. On the 3rd of each month you get a short report: spending, enquiries, what I am changing.',
    ),
  },
];

const faq = [
  {
    q: T('Ile muszę wydać na same reklamy?', 'How much do I need to spend on the ads themselves?'),
    a: T(
      'Budżet reklam płacisz bezpośrednio Google, osobno od mojego wynagrodzenia. Dla lokalnej firmy usługowej sensowny start to ok. 300-450 zł miesięcznie: kampania tylko w wyszukiwarce, na najbardziej konkretne frazy i w Twojej okolicy. Przy kliknięciu za 2-3 zł to ok. 100-200 wejść osób, które szukają dokładnie tego, co robisz. Mniej zwykle nie ma sensu, bo za mało danych, żeby cokolwiek ocenić.',
      'You pay the ad budget directly to Google, separately from my fee. For a local service business a sensible start is about PLN 300-450 a month: a search-only campaign on the most specific keywords, in your area. At PLN 2-3 per click that is about 100-200 visits from people looking for exactly what you do. Less usually makes no sense, because there is too little data to judge anything.',
    ),
  },
  {
    q: T('Czyje jest konto reklamowe, domena i strona?', 'Who owns the ad account, the domain and the website?'),
    a: T(
      'Twoje. Konto Google Ads, domena i kod strony są na Twoją firmę. Jeśli kiedyś się rozstaniemy, wszystko zostaje u Ciebie.',
      'You do. The Google Ads account, the domain and the website code are in your company’s name. If we ever part ways, everything stays with you.',
    ),
  },
  {
    q: T('Jak to możliwe, że hosting jest za darmo?', 'How can hosting be free?'),
    a: T(
      'Strony robię w nowoczesnej technologii (Astro), która działa na globalnej sieci Cloudflare. Dla stron firmowych ich darmowy plan w zupełności wystarcza, a strona ładuje się błyskawicznie. Płacisz tylko za domenę, zwykle kilkadziesiąt złotych rocznie.',
      'I build websites with modern technology (Astro) that runs on Cloudflare’s global network. For business websites their free plan is more than enough, and the site loads instantly. You only pay for the domain, usually a few dozen złoty a year.',
    ),
  },
  {
    q: T('Czym jest widoczność w ChatGPT?', 'What is visibility in ChatGPT?'),
    a: T(
      'Coraz więcej osób zamiast w Google pyta ChatGPT, Copilota albo Gemini: „gdzie w okolicy zrobić…”, „kto produkuje…”. Te narzędzia polecają firmy, o których mają wiarygodne informacje. Dbam o to, żeby je miały: dane na stronie, wpisy w bazach, z których korzysta AI, i treści odpowiadające na konkretne pytania klientów.',
      'More and more people ask ChatGPT, Copilot or Gemini instead of Google: “where nearby can I get…”, “who makes…”. These tools recommend businesses they have reliable information about. I make sure they have it: data on your website, entries in the databases AI uses, and content that answers customers’ specific questions.',
    ),
  },
  {
    q: T('Dlaczego tylko 3 firmy naraz?', 'Why only 3 businesses at a time?'),
    a: T(
      'Bo chcę być Twoim jednoosobowym działem marketingu i rozwoju, a nie wykonawcą, który zrobi stronę i zniknie. Przy trzech firmach znam każdą kampanię, każdy problem i każdą liczbę.',
      'Because I want to be your one-person marketing and growth department, not a contractor who builds a website and disappears. With three businesses I know every campaign, every problem and every number.',
    ),
  },
];

const faqLd = {
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base jsonLd={[faqLd]} lang={lang}>
  <!-- HERO -->
  <section class="hero" data-flow>
    <div class="wrap hero-grid">
      <div class="hero-text">
        <div class="intro">
          {
            site.avatar && (
              <img src={site.avatar} alt={site.personName} width="112" height="112" decoding="async" />
            )
          }
          <p>
            <strong>{site.personName}</strong>
            <span>{T('jednoosobowy dział marketingu dla małych i średnich firm', 'a one-person marketing department for small and medium-sized businesses')}</span>
          </p>
          <!-- Przełącznik języka w treści, przy przedstawieniu się (na prośbę Olka 26.11.2026). -->
          <div class="intro-lang"><LangSwitch lang={lang} /></div>
        </div>
        {
          en ? (
            <h1>
              More customers online. <span class="grad">Marketing off your&nbsp;plate.</span>
            </h1>
          ) : (
            <h1>
              Więcej klientów z internetu. <span class="grad">Marketing masz z&nbsp;głowy.</span>
            </h1>
          )
        }
        <p class="lead">
          {T(
            'Strona, reklamy Google, widoczność w ChatGPT i porządek w sprzedaży. Biorę to na siebie i co miesiąc pokazuję, ile to kosztowało i ile przyniosło.',
            'Website, Google Ads, visibility in ChatGPT and order in your sales. I take it on and every month I show you what it cost and what it brought.',
          )}
        </p>
        <div class="hosting glass">
          <span class="hosting-ico" aria-hidden="true"><Icon name="bolt" /></span>
          {
            en ? (
              <p>
                A fast website, <strong>hosting for PLN&nbsp;0.</strong> You pay {p.website}
                {priceSuffix} once for the build, and then only for the domain each year.
              </p>
            ) : (
              <p>
                Szybka strona, <strong>hosting za 0&nbsp;zł.</strong> Płacisz raz {p.website}
                {priceSuffix} za wykonanie, a potem co rok tylko za domenę.
              </p>
            )
          }
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" href="#kontakt">{T('Umów bezpłatną rozmowę', 'Book a free call')}</a>
          {
            site.phone ? (
              <a class="btn btn-glass" href={`tel:${site.phoneHref || site.phone}`}>
                {phoneShown}
              </a>
            ) : (
              <a class="btn btn-glass" href="#realizacje">
                {T('Zobacz realizacje', 'See my work')}
              </a>
            )
          }
        </div>
      </div>

      <div class="hero-visual" aria-label={T('Przykładowe wyniki: Art Papier, Google Ads', 'Example results: Art Papier, Google Ads')}>
        <div class="dash glass">
          <div class="dash-head">
            <span class="dot"></span>
            <span class="small muted">Art Papier · Google Ads</span>
          </div>
          <div class="kpis">
            <div>
              <p class="small muted label"><i class="key red"></i>{T('Koszt konwersji', 'Cost per conversion')}</p>
              <p class="big red">{T('33,29 zł', 'PLN 33.29')}</p>
              <p class="delta down">↓ {T('z 75,80 zł', 'from PLN 75.80')}</p>
            </div>
            <div>
              <p class="small muted label"><i class="key green"></i>{T('Zapytania z reklam', 'Enquiries from ads')}</p>
              <p class="big green">20<small> / {T('mies.', 'month')}</small></p>
              <p class="delta up">↑ {T('z 0', 'from 0')}</p>
            </div>
          </div>
          <!-- Wykres poglądowy (na prośbę Olka 26.11.2026): koszt zapytania (czerwony) spada, liczba zapytań (zielony)
               rośnie od zera; linie się przecinają. Liczby obok są z eksportu Art Papier. -->
          <svg viewBox="0 0 300 100" class="spark" aria-hidden="true">
            <defs>
              <linearGradient id="fr" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#fb7185" stop-opacity=".22"></stop>
                <stop offset="1" stop-color="#fb7185" stop-opacity="0"></stop>
              </linearGradient>
              <linearGradient id="fg" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#4ade80" stop-opacity=".25"></stop>
                <stop offset="1" stop-color="#4ade80" stop-opacity="0"></stop>
              </linearGradient>
            </defs>
            <g stroke="rgb(255 255 255 / 8%)" stroke-width="1">
              <line x1="0" y1="25" x2="300" y2="25"></line>
              <line x1="0" y1="50" x2="300" y2="50"></line>
              <line x1="0" y1="75" x2="300" y2="75"></line>
            </g>
            <path d="M0 12 C60 14 100 30 150 52 S240 80 300 84 L300 100 L0 100Z" fill="url(#fr)"></path>
            <path d="M0 98 C60 96 100 80 150 52 S240 30 300 28 L300 100 L0 100Z" fill="url(#fg)"></path>
            <path class="line" pathLength="1" d="M0 12 C60 14 100 30 150 52 S240 80 300 84" fill="none" stroke="#fb7185" stroke-width="3" stroke-linecap="round"></path>
            <path class="line" pathLength="1" d="M0 98 C60 96 100 80 150 52 S240 30 300 28" fill="none" stroke="#4ade80" stroke-width="3" stroke-linecap="round"></path>
            <circle cx="300" cy="84" r="4" fill="#fb7185"></circle>
            <circle cx="300" cy="28" r="4" fill="#4ade80"></circle>
          </svg>
          <p class="small muted caption">
            {T(
              'Koszt konwersji (zapytania lub zamówienia): 6-19.10 → 20-31.10.2026. Zapytania z reklam: przed kampanią 0, teraz ok. 20 miesięcznie.',
              'Cost per conversion (enquiry or order): 6-19 Oct → 20-31 Oct 2026. Enquiries from ads: 0 before the campaign, now about 20 a month.',
            )}
          </p>
        </div>
        <div class="chip-float glass c1"><strong>{T('5 dni', '5 days')}</strong><span>{T('tyle zajęło zbudowanie sklepu', 'to build the online shop')}</span></div>
        <div class="chip-float glass c2"><strong>55×</strong><span>{T('tyle razy AI zacytowało stronę w 2 tygodnie', 'times AI cited the website in 2 weeks')}</span></div>
      </div>
    </div>

    <div class="marquee" aria-label={T('Firmy, dla których pracowałem', 'Companies I have worked for')}>
      <div class="track">
        {
          [...logos, ...logos].map((l, i) => (
            <img
              src={`/logos/${l.file}.webp`}
              alt={i < logos.length ? l.name : ''}
              aria-hidden={i >= logos.length ? 'true' : undefined}
              width={Math.round((l.w * l.h) / 96)}
              height={l.h}
              loading="lazy"
              decoding="async"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- PYTANIA -->
  <section class="pains" data-flow>
    <div class="wrap">
      <div class="reveal center narrow">
        <p class="eyebrow">{T('Brzmi znajomo?', 'Sound familiar?')}</p>
      </div>
      <div class="grid grid-2 pain-grid">
        {
          pains.map((t) => (
            <div class="glass pain reveal">
              <span class="q" aria-hidden="true">?</span>
              <p>{t}</p>
            </div>
          ))
        }
      </div>
      <h2 class="pains-answer center narrow reveal">
        {T('Prowadzisz firmę. Czy masz czas na drugi etat jako marketingowiec?', 'You run a business. Do you have time for a second job as a marketer?')}
      </h2>
    </div>
  </section>

  <!-- CAŁA FIRMA -->
  <section class="whole" data-flow>
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">{T('Więcej niż marketing', 'More than marketing')}</p>
        {
          en ? (
            <h2>
              I look after your business <span class="grad">as a whole</span>
            </h2>
          ) : (
            <h2>
              Zajmuję się Twoją firmą <span class="grad">kompleksowo</span>
            </h2>
          )
        }
        <p class="lead">
          {T(
            'Reklama nie pomoże, jeśli oferta jest niejasna, a zapytania czekają tydzień na odpowiedź. Dlatego zaczynam od całej firmy, a dopiero potem włączam marketing.',
            'Ads won’t help if the offer is unclear and enquiries wait a week for a reply. That is why I start with the whole business and only then switch on marketing.',
          )}
        </p>
      </div>
      <ol class="whole-grid">
        {
          whole.map((w, i) => (
            <li class="glass card reveal">
              <div class="whole-top">
                <div class="icon">
                  <Icon name={w.icon} />
                </div>
                <span class="n">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- USŁUGI -->
  <section id="uslugi" data-flow>
    <div class="wrap">
      <div class="reveal narrow">
        <p class="eyebrow">{T('Co dla Ciebie zrobię', 'What I will do for you')}</p>
