---
import { site } from '../config/site';
import { type Lang, tr, href } from '../i18n';
interface Props {
  lang?: Lang;
}
const { lang = 'pl' } = Astro.props;
const T = tr(lang);
const home = href(lang, '/');
const links = [
  { href: `${home}#uslugi`, label: T('Usługi', 'Services') },
  { href: `${home}#realizacje`, label: T('Realizacje', 'Work') },
  { href: `${home}#ceny`, label: T('Ceny', 'Pricing') },
  { href: `${home}#faq`, label: T('Pytania', 'FAQ') },
];
---

<header class="site-header">
  <div class="pill glass" data-refl={site.experiments.reflection ? '1' : undefined}>
    <span class="refl" aria-hidden="true"></span>
    <a href={home} class="brand" aria-label={`${site.brandName} – ${T('strona główna', 'home page')}`}>
      {
        site.avatar ? (
          <img class="mono" src={site.avatar} alt="" width="64" height="64" decoding="async" />
        ) : (
          <span class="mono" aria-hidden="true">AC</span>
        )
      }
      <span class="name">{site.brandName}</span>
    </a>
    <nav aria-label={T('Główna', 'Main')}>
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-primary cta" href={`${home}#kontakt`}>{T('Bezpłatna rozmowa', 'Free call')}</a>
  </div>
  <!-- Filtr soczewki dla menu (wypełnia go skrypt niżej). -->
  <svg class="lens-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="lens" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
      <feImage id="lens-map" x="0" y="0" result="map" preserveAspectRatio="none"></feImage>
      <feDisplacementMap in="SourceGraphic" in2="map" scale="0" xChannelSelector="R" yChannelSelector="G"
      ></feDisplacementMap>
    </filter>
  </svg>
</header>

<script>
  // Prawdziwe „szkło” w menu (na prośbę Olka 26.11.2026): przy krawędziach tło pod menu jest wyginane jak
  // w soczewce (feDisplacementMap w backdrop-filter), w środku zostaje prawie nietknięte. Działa tylko
  // w przeglądarkach na Chromium (Chrome, Edge, Opera, Android); Safari i Firefox nie obsługują filtrów SVG
  // w backdrop-filter, więc tam zostaje zwykłe rozmycie z .glass.
  const pill = document.querySelector<HTMLElement>('.site-header .pill');
  const brands = (navigator as Navigator & { userAgentData?: { brands: { brand: string }[] } }).userAgentData?.brands;
  if (pill && brands?.some((b) => /Chromium/.test(b.brand))) {
    const img = document.getElementById('lens-map')!;
    const disp = document.querySelector('#lens feDisplacementMap')!;
    const BAND = 18; // szerokość pasa przy krawędzi, w którym obraz się wygina (px)
    const draw = () => {
      const w = Math.round(pill.offsetWidth);
      const h = Math.round(pill.offsetHeight);
      if (!w || !h) return;
      const c = document.createElement('canvas');
      c.width = w;
      c.height = h;
      const ctx = c.getContext('2d')!;
      const data = ctx.createImageData(w, h);
      const r = h / 2; // menu to „pigułka”: promień = pół wysokości
      for (let y = 0; y < h; y++)
        for (let x = 0; x < w; x++) {
          // Odległość od krawędzi zaokrąglonego prostokąta i kierunek do krawędzi (normalna).
          const qx = Math.abs(x + 0.5 - w / 2) - (w / 2 - r);
          const qy = Math.abs(y + 0.5 - h / 2) - (h / 2 - r);
          const ox = Math.max(qx, 0);
          const oy = Math.max(qy, 0);
          const len = Math.hypot(ox, oy);
          const dist = len > 0 ? r - len : r - Math.max(qx, qy) - 0; // odległość od krawędzi do środka
          let nx = 0;
          let ny = 0;
          if (len > 0) {
            nx = (ox / len) * Math.sign(x + 0.5 - w / 2);
            ny = (oy / len) * Math.sign(y + 0.5 - h / 2);
          } else if (qx > qy) nx = Math.sign(x + 0.5 - w / 2);
          else ny = Math.sign(y + 0.5 - h / 2);
          const k = dist < BAND ? Math.pow(1 - Math.max(dist, 0) / BAND, 2) : 0;
          const i = (y * w + x) * 4;
          // Próbkujemy tło bliżej środka: obraz przy krawędzi jest rozciągnięty i „zawinięty” jak w szkle.
          data.data[i] = 128 - nx * k * 127;
          data.data[i + 1] = 128 - ny * k * 127;
          data.data[i + 2] = 128;
          data.data[i + 3] = 255;
        }
      ctx.putImageData(data, 0, 0);
      img.setAttribute('href', c.toDataURL());
      img.setAttribute('width', String(w));
      img.setAttribute('height', String(h));
      disp.setAttribute('scale', String(Math.min(60, h)));
      pill.classList.add('lens');
    };
    draw();
    new ResizeObserver(draw).observe(pill);
  } else if (pill) {
    // Safari, Firefox, iPhone: wersja „prawie” (na prośbę Olka 27.11.2026). Bez wyginania tła, ale refleks
    // światła i tęczowa krawędź przesuwają się przy przewijaniu, jak w szkle obracanym w dłoni. Tylko zmienne CSS.
    pill.classList.add('glass-alt');

    // TEST (na prośbę Olka 27.11.2026): w krawędziach menu przewija się odbity w pionie zrzut strony, jak odbicie
    // w szkle. Zrzut robi scripts/reflection.cjs. Ładujemy go dopiero po wczytaniu strony i tylko na stronie głównej.
    const refl = pill.querySelector<HTMLElement>('.refl');
    const home = /^\/(en\/)?$/.test(location.pathname);
    if (refl && pill.dataset.refl && home) {
      addEventListener('load', () =>
        setTimeout(() => {
          const phone = innerWidth < 760;
          const img = new Image();
          img.src = phone ? '/img/odbicie-telefon.webp' : '/img/odbicie-komputer.webp';
          img.onload = () => {
            refl.style.backgroundImage = `url(${img.src})`;
            let raf = 0;
            const place = () => {
              raf = 0;
              const r = pill.getBoundingClientRect();
              const H = document.documentElement.scrollHeight;
              refl.style.backgroundSize = `${innerWidth}px ${H}px`;
              refl.style.backgroundPosition = `${-r.left}px ${-(scrollY + r.top)}px`;
            };
            place();
            addEventListener('scroll', () => (raf ||= requestAnimationFrame(place)), { passive: true });
            addEventListener('resize', () => (raf ||= requestAnimationFrame(place)));
            pill.classList.add('has-refl');
          };
        }, 800),
      );
    }
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let raf = 0;
      const move = () => {
        raf = 0;
        const t = scrollY / 900;
        pill.style.setProperty('--gx', `${50 + Math.sin(t) * 40}%`);
        pill.style.setProperty('--ga', `${(scrollY / 6) % 360}deg`);
      };
      addEventListener('scroll', () => (raf ||= requestAnimationFrame(move)), { passive: true });
      move();
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding: 12px 16px 0;
  }
  .pill {
    width: min(100%, var(--max));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px 8px 8px 14px;
    border-radius: 999px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .mono {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--grad);
    color: #06121a;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.02em;
  }
  .lens-defs {
    position: absolute;
    width: 0;
    height: 0;
  }
  .pill.lens {
    -webkit-backdrop-filter: url(#lens) blur(2px) saturate(180%);
    backdrop-filter: url(#lens) blur(2px) saturate(180%);
  }
  /* Wersja „prawie Liquid Glass” dla przeglądarek bez filtrów SVG w backdrop-filter (Safari, Firefox):
     mocniejsze rozmycie z podbitym kolorem, grube jasne krawędzie od środka, tęczowa obwódka i refleks. */
  .pill.glass-alt {
    --gx: 50%;
    --ga: 0deg;
    background: linear-gradient(180deg, rgb(255 255 255 / 12%), rgb(255 255 255 / 4%) 55%, rgb(255 255 255 / 8%));
    -webkit-backdrop-filter: blur(10px) saturate(220%) brightness(1.1);
    backdrop-filter: blur(10px) saturate(220%) brightness(1.1);
    box-shadow:
      inset 0 1.5px 0 rgb(255 255 255 / 55%),
      inset 0 -1px 0 rgb(255 255 255 / 18%),
      inset 0 0 14px rgb(255 255 255 / 10%),
      inset 0 -8px 16px -10px rgb(160 200 255 / 25%),
      0 18px 40px rgb(0 0 0 / 45%);
  }
  .pill.glass-alt::before {
    padding: 1.2px;
    background: conic-gradient(
      from var(--ga),
      rgb(255 255 255 / 70%),
      rgb(120 220 255 / 45%),
      rgb(255 255 255 / 12%),
      rgb(190 140 255 / 45%),
      rgb(255 255 255 / 60%),
      rgb(255 160 220 / 35%),
      rgb(255 255 255 / 12%),
      rgb(255 255 255 / 70%)
    );
  }
  .pill.glass-alt::after {
    background:
      radial-gradient(120px 40px at var(--gx) 0%, rgb(255 255 255 / 30%), transparent 70%),
      radial-gradient(160px 30px at calc(100% - var(--gx)) 100%, rgb(255 255 255 / 10%), transparent 70%);
  }
  /* Odbicie strony w krawędziach menu (test): odwrócone w pionie, widoczne tylko przy górnej i dolnej krawędzi. */
  .refl {
    display: none;
  }
  .pill.has-refl .refl {
    display: block;
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-repeat: no-repeat;
    transform: scaleY(-1);
    opacity: 0.6;
    filter: blur(1px) saturate(1.5) brightness(1.15);
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 38%, transparent 62%, #000);
    mask-image: linear-gradient(to bottom, #000, transparent 38%, transparent 62%, #000);
    pointer-events: none;
  }
  img.mono {
    object-fit: cover;
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 25%);
  }
  nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  nav a {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 999px;
    transition: background 0.2s;
  }
  nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 8%);
  }
  .cta {
    padding: 0.7em 1.2em;
    font-size: 0.92rem;
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
    .cta {
      margin-left: auto;
    }
  }
  @media (max-width: 420px) {
    .name {
      display: none;
    }
    .cta {
      padding: 0.65em 1em;
      font-size: 0.85rem;
    }
  }
</style>
