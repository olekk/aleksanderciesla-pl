---
import { site } from '../config/site';
const links = [
  { href: '/#uslugi', label: 'Usługi' },
  { href: '/#realizacje', label: 'Realizacje' },
  { href: '/#ceny', label: 'Ceny' },
  { href: '/#faq', label: 'Pytania' },
];
---

<header class="site-header">
  <div class="pill glass">
    <a href="/" class="brand" aria-label={`${site.brandName} – strona główna`}>
      {
        site.avatar ? (
          <img class="mono" src={site.avatar} alt="" width="64" height="64" decoding="async" />
        ) : (
          <span class="mono" aria-hidden="true">AC</span>
        )
      }
      <span class="name">{site.brandName}</span>
    </a>
    <nav aria-label="Główna">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
    <a class="btn btn-primary cta" href="/#kontakt">Bezpłatna rozmowa</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 12px;
    z-index: 50;
    padding: 12px 16px 0;
  }
  .pill {
    width: min(100%, var(--max));
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 8px 8px 8px 14px;
    border-radius: 999px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 650;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .mono {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--grad);
    color: #06121a;
    font-size: 0.75rem;
    font-weight: 750;
    letter-spacing: 0.02em;
  }
  img.mono {
    object-fit: cover;
    box-shadow: 0 0 0 1.5px rgb(255 255 255 / 25%);
  }
  nav {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  nav a {
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 999px;
    transition: background 0.2s;
  }
  nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 8%);
  }
  .cta {
    padding: 0.7em 1.2em;
    font-size: 0.92rem;
  }
  @media (max-width: 860px) {
    nav {
      display: none;
    }
    .cta {
      margin-left: auto;
    }
  }
  @media (max-width: 420px) {
    .name {
      display: none;
    }
  }
</style>
