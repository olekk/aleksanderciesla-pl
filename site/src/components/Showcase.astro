---
// Nagranie strony: wersja komputerowa w szklanej ramce przeglądarki + wersja na telefon obok.
interface Props {
  video: string;
  label: string;
  url?: string;
  mobile?: boolean;
  eager?: boolean;
}
// eager: plakat od razu w HTML (realizacje na górze strony – plakat bywa elementem LCP); reszta plakatów
// dochodzi skryptem blisko ekranu (Base.astro), w rozmiarze pod ekran.
const { video, label, url, mobile = true, eager = false } = Astro.props;
const host = url ? new URL(url).host : label;
---

<figure class="showcase" class:list={[{ 'no-phone': !mobile }]}>
  <div class="browser glass">
    <div class="chrome" aria-hidden="true">
      <span></span><span></span><span></span>
      <em>{host}</em>
    </div>
    <video
      data-autoplay
      muted
      loop
      playsinline
      preload="none"
      width="1280"
      height="800"
      data-poster={`/media/${video}-desktop`}
      poster={eager ? `/media/${video}-desktop.webp` : undefined}
      aria-label={`Nagranie strony ${label} na komputerze`}
    >
      <source src={`/media/${video}-desktop.mp4`} type="video/mp4" />
    </video>
  </div>
  {
    mobile && (
      <div class="phone">
        <video
          data-autoplay
          muted
          loop
          playsinline
          preload="none"
          width="520"
          height="886"
          data-poster={`/media/${video}-mobile`}
          poster={eager ? `/media/${video}-mobile-260.webp` : undefined}
          aria-label={`Nagranie strony ${label} na telefonie`}
        >
          <source src={`/media/${video}-mobile.mp4`} type="video/mp4" />
        </video>
      </div>
    )
  }
</figure>

<style>
  .showcase {
    position: relative;
    margin: 0;
    padding-right: 12%;
    padding-bottom: 7%;
  }
  .showcase.no-phone {
    padding: 0;
  }
  .browser {
    padding: 0 6px 6px;
    border-radius: 18px;
  }
  .chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 8px;
  }
  .chrome span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: rgb(255 255 255 / 22%);
  }
  .chrome em {
    font-style: normal;
    font-size: 0.72rem;
    color: var(--text-3);
    margin: 0 auto;
    background: rgb(255 255 255 / 7%);
    border-radius: 8px;
    padding: 3px 14px;
    max-width: 55%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .browser video {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-radius: 12px;
    background: #111;
  }
  .phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 24%;
    padding: 5px;
    border-radius: 26px;
    background: linear-gradient(160deg, rgb(255 255 255 / 35%), rgb(255 255 255 / 8%) 40%, rgb(255 255 255 / 18%));
    -webkit-backdrop-filter: var(--blur);
    backdrop-filter: var(--blur);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 40%),
      0 24px 50px rgb(0 0 0 / 55%);
  }
  .phone video {
    width: 100%;
    height: auto;
    aspect-ratio: 390 / 664;
    object-fit: cover;
    object-position: top;
    border-radius: 21px;
    background: #111;
  }
  @media (max-width: 560px) {
    .phone {
      padding: 3px;
      border-radius: 16px;
    }
    .phone video {
      border-radius: 13px;
    }
    .browser {
      border-radius: 14px;
      padding: 0 4px 4px;
    }
    .chrome {
      padding: 7px 6px;
    }
  }
</style>
