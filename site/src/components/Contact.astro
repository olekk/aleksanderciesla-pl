---
import { site } from '../config/site';
import { type Lang, tr } from '../i18n';
interface Props {
  lang?: Lang;
}
const { lang = 'pl' } = Astro.props;
const T = tr(lang);
const services =
  lang === 'en'
    ? ['Website', 'Google Ads', 'Visibility in ChatGPT', 'Customer database and sales', 'Offer and promotions', 'Everything, let’s talk']
    : ['Strona internetowa', 'Google Ads', 'Widoczność w ChatGPT', 'Baza klientów i sprzedaż', 'Oferta i promocje', 'Całość, porozmawiajmy'];
// Komunikaty formularza dla skryptu (w języku strony).
const msg = {
  name: T('Wpisz, proszę, swoje imię.', 'Please enter your name.'),
  contact: T('Zostaw telefon albo e-mail, żebym mógł odpowiedzieć.', 'Leave a phone number or email so I can reply.'),
  email: T('Sprawdź adres e-mail.', 'Please check the email address.'),
  sending: T('Wysyłam…', 'Sending…'),
  ok: T(
    'Dziękuję! Wiadomość doszła. Odezwę się najpóźniej następnego dnia roboczego.',
    'Thank you! Your message has arrived. I will get back to you by the next working day at the latest.',
  ),
  fail: T('Nie udało się wysłać formularza.', 'The form could not be sent.'),
  failMail: T('Napisz proszę bezpośrednio na', 'Please write directly to'),
  retry: T('Spróbuj za chwilę.', 'Please try again in a moment.'),
  submit: T('Wyślij, odezwę się', 'Send, I’ll get back to you'),
};
---

<section id="kontakt" class="contact">
  <div class="wrap grid-contact">
    <div class="reveal">
      <p class="eyebrow">{T('Kontakt', 'Contact')}</p>
      {
        lang === 'en' ? (
          <h2>
            Let’s talk for <span class="grad">30 minutes.</span> No strings attached.
          </h2>
        ) : (
          <h2>
            Porozmawiajmy <span class="grad">30 minut.</span> Bez zobowiązań.
          </h2>
        )
      }
      <p class="lead">
        {T(
          'Opowiesz, czym się zajmujesz i skąd dziś przychodzą klienci. Ja powiem, co zrobiłbym na Twoim miejscu i ile by to kosztowało.',
          'You tell me what you do and where your customers come from today. I tell you what I would do in your place and what it would cost.',
        )}
      </p>
      <ul class="check">
        <li>{T('Pierwsza rozmowa i przegląd Twojej strony są bezpłatne.', 'The first call and a review of your website are free.')}</li>
        <li>
          {T(
            `Jeśli jesteś ${site.meetArea}, chętnie spotkam się osobiście. Z resztą Polski rozmawiamy online.`,
            `If you are ${site.meetAreaEn}, I am happy to meet in person. Everywhere else we talk online.`,
          )}
        </li>
        <li>{T('Rozmawiasz ze mną, nie z handlowcem. To ja potem robię robotę.', 'You talk to me, not to a salesperson. I am the one who then does the work.')}</li>
      </ul>
      <div class="direct">
        {
          site.phone && (
            <a class="btn btn-primary" href={`tel:${site.phoneHref || site.phone}`}>
              {T('Zadzwoń', 'Call')}: {lang === 'en' ? `+48 ${site.phone}` : site.phone}
            </a>
          )
        }
        {
          site.email && (
            <a class="btn btn-glass" href={`mailto:${site.email}`}>
              {site.email}
            </a>
          )
        }
      </div>
    </div>

    <form class="form glass reveal" id="formularz" action="/api/kontakt" method="post" data-email={site.email} data-msg={JSON.stringify(msg)} novalidate>
      <fieldset class="chips">
        <legend>{T('Co Cię interesuje?', 'What are you interested in?')}</legend>
        {
          services.map((s) => (
            <label class="chip">
              <input type="checkbox" name="uslugi" value={s} />
              <span>{s}</span>
            </label>
          ))
        }
      </fieldset>

      <div class="row">
        <label>
          <span>{T('Imię', 'Name')} *</span>
          <input name="imie" autocomplete="given-name" required maxlength="80" />
        </label>
        <label>
          <span>{T('Firma lub strona www', 'Company or website')}</span>
          <input name="firma" autocomplete="organization" maxlength="120" />
        </label>
      </div>
      <div class="row">
        <label>
          <span>{T('Telefon', 'Phone')}</span>
          <input name="telefon" type="tel" autocomplete="tel" maxlength="30" />
        </label>
        <label>
          <span>E-mail</span>
          <input name="email" type="email" autocomplete="email" maxlength="120" />
        </label>
      </div>
      <label>
        <span>{T('Kilka słów o firmie i o tym, czego potrzebujesz', 'A few words about your business and what you need')}</span>
        <textarea name="wiadomosc" rows="4" maxlength="3000"></textarea>
      </label>

      <!-- Pułapka na boty: pole niewidoczne dla ludzi. -->
      <label class="hp" aria-hidden="true">
        {T('Nie wypełniaj', 'Leave empty')} <input name="strona_www" tabindex="-1" autocomplete="off" />
      </label>
      <input type="hidden" name="t" value="" />

      <button class="btn btn-primary submit" type="submit">{msg.submit}</button>
      <p class="status small" role="status" aria-live="polite"></p>
      <p class="muted small fine">
        {T(
          'Podaj telefon albo e-mail. Twoje dane wykorzystam tylko do odpowiedzi na tę wiadomość.',
          'Give a phone number or email. I will use your details only to reply to this message.',
        )}
      </p>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#formularz');
  if (form) {
    const t = form.elements.namedItem('t') as HTMLInputElement;
    t.value = String(Date.now());
    const status = form.querySelector<HTMLElement>('.status')!;
    const btn = form.querySelector<HTMLButtonElement>('.submit')!;
    const email = form.dataset.email || '';
    const m = JSON.parse(form.dataset.msg || '{}') as Record<string, string>;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const imie = String(fd.get('imie') || '').trim();
      const tel = String(fd.get('telefon') || '').trim();
      const mail = String(fd.get('email') || '').trim();
      status.className = 'status small';
      if (!imie) return show(m.name, 'err');
      if (!tel && !mail) return show(m.contact, 'err');
      if (mail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(mail)) return show(m.email, 'err');

      btn.disabled = true;
      btn.textContent = m.sending;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...Object.fromEntries(fd), uslugi: fd.getAll('uslugi') }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        t.value = String(Date.now());
        show(m.ok, 'ok');
      } catch {
        show(
          `${m.fail} ${email ? `${m.failMail} ${email}.` : m.retry}`,
          'err',
        );
      } finally {
        btn.disabled = false;
        btn.textContent = m.submit;
      }
    });

    function show(msg: string, kind: 'ok' | 'err') {
      status.textContent = msg;
      status.classList.add(kind);
    }
  }
</script>

<style>
  .grid-contact {
    display: grid;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 960px) {
    .grid-contact {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }
  .direct {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .form {
    padding: clamp(20px, 3vw, 32px);
    display: grid;
    gap: 16px;
  }
  .row {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 560px) {
    .row {
      grid-template-columns: 1fr 1fr;
    }
  }
  label > span,
  legend {
    display: block;
    font-size: 0.85rem;
    color: var(--text-2);
    margin-bottom: 6px;
  }
  input,
  textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--text);
    background: rgb(0 0 0 / 25%);
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 14px;
    padding: 12px 14px;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-color: var(--teal);
    background: rgb(0 0 0 / 35%);
  }
  textarea {
    resize: vertical;
  }
  .chips {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips legend {
    margin-bottom: 10px;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .chip span {
    display: inline-block;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.88rem;
    color: var(--text-2);
    background: rgb(255 255 255 / 6%);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 12%);
    cursor: pointer;
    transition: all 0.2s;
    margin: 0;
  }
  .chip input:checked + span {
    color: #06121a;
    background: linear-gradient(120deg, #99f6e4, #93c5fd);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 60%);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .submit {
    justify-self: start;
  }
  .submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }
  .status:empty {
    display: none;
  }
  .status {
    margin: 0;
    padding: 10px 14px;
    border-radius: 12px;
  }
  .status.ok {
    background: rgb(94 234 212 / 12%);
    color: var(--teal);
  }
  .status.err {
    background: rgb(244 114 182 / 12%);
    color: #fbcfe8;
  }
  .fine {
    margin: 0;
  }
</style>
