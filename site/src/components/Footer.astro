---
import { site } from '../config/site';
import LangSwitch from './LangSwitch.astro';
import { type Lang, tr, href } from '../i18n';
interface Props {
  lang?: Lang;
  translated?: boolean;
}
const { lang = 'pl', translated = true } = Astro.props;
const T = tr(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <a href={href(lang, '/')} class="brand"><span class="mono" aria-hidden="true">AC</span>{site.brandName}</a>
      <p class="muted small">
        {T(
          'Marketing i rozwój małych i średnich przedsiębiorstw: strony, Google Ads, widoczność w AI i sprzedaż.',
          'Marketing and growth for small and medium-sized businesses: websites, Google Ads, AI visibility and sales.',
        )}
      </p>
      {translated && <LangSwitch lang={lang} />}
      {site.companyInfo && <p class="muted small">{site.companyInfo}</p>}
    </div>
    <nav class="small" aria-label={T('Stopka', 'Footer')}>
      <a href={href(lang, '/art-papier/')}>Art Papier</a>
      <a href={href(lang, '/hc-instal/')}>HC INSTAL</a>
      <a href={href(lang, '/strony/')}>{T('Strony', 'Websites')}</a>
      <a href={`${href(lang, '/')}#kontakt`}>{T('Kontakt', 'Contact')}</a>
    </nav>
    <div class="small">
      {site.phone && <p><a href={`tel:${site.phoneHref || site.phone}`}>{site.phone}</a></p>}
      {site.email && <p><a href={`mailto:${site.email}`}>{site.email}</a></p>}
    </div>
  </div>
  <div class="wrap fine small muted">© {year} {site.personName}</div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 56px 0 28px;
    background: rgb(0 0 0 / 35%);
  }
  .cols {
    display: grid;
    gap: 28px;
  }
  @media (min-width: 760px) {
    .cols {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 650;
    text-decoration: none;
    margin-bottom: 12px;
  }
  .mono {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--grad);
    color: #06121a;
    font-size: 0.7rem;
    font-weight: 750;
  }
  nav {
    display: grid;
    gap: 8px;
    align-content: start;
  }
  nav a,
  .site-footer p a {
    color: var(--text-2);
    text-decoration: none;
  }
  nav a:hover,
  .site-footer p a:hover {
    color: var(--text);
  }
  .fine {
    border-top: 1px solid var(--line);
    margin-top: 32px;
    padding-top: 18px;
  }
</style>
