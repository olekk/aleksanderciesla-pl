{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aleksanderciesla-pl",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Przez Workera idą tylko strony (noindex na podglądzie, www → apex); statyka bez limitu wywołań.
    "run_worker_first": ["/*", "!/_astro/*", "!/media/*", "!/favicon.svg", "!/robots.txt"]
  },
  "vars": {
    // Na tym hoście nie dokładamy noindex.
    "PRODUCTION_HOST": "aleksanderciesla.pl",
    // Powiadomienia z formularza (Cloudflare Email Routing, działa po podpięciu domeny).
    // MAIL_TO musi być zweryfikowanym adresem docelowym w Email Routing.
    "MAIL_FROM": "formularz@aleksanderciesla.pl",
    "MAIL_TO": ""
  },
  // Odkomentować po utworzeniu bazy (TODO.md): npx wrangler d1 create aleksanderciesla-pl
  // "d1_databases": [{ "binding": "DB", "database_name": "aleksanderciesla-pl", "database_id": "<id z komendy>", "migrations_dir": "migrations" }],
  // Odkomentować po włączeniu Email Routing dla domeny:
  // "send_email": [{ "name": "MAILER" }],
  // Domena dojdzie po kupnie: "routes": [{ "pattern": "aleksanderciesla.pl", "custom_domain": true }, { "pattern": "www.aleksanderciesla.pl", "custom_domain": true }]
  "env": {
    "podglad": {
      "name": "aleksanderciesla-pl-podglad",
      "vars": { "PRODUCTION_HOST": "aleksanderciesla.pl" }
    }
  }
}
