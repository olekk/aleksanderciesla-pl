{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aleksanderciesla-pl",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Przez Workera idą tylko strony (noindex na podglądzie, www → apex); statyka bez limitu wywołań.
    "run_worker_first": ["/*", "!/_astro/*", "!/media/*", "!/favicon.svg", "!/robots.txt"]
  },
  "vars": {
    // Na tym hoście nie dokładamy noindex.
    "PRODUCTION_HOST": "aleksanderciesla.pl"
  },
  // Domena dojdzie po kupnie: "routes": [{ "pattern": "aleksanderciesla.pl", "custom_domain": true }, { "pattern": "www.aleksanderciesla.pl", "custom_domain": true }]
  "env": {
    "podglad": {
      "name": "aleksanderciesla-pl-podglad",
      "vars": { "PRODUCTION_HOST": "aleksanderciesla.pl" }
    }
  }
}
